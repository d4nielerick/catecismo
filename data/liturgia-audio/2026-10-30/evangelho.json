  "linhas": [
    {
      "t0": 0.2,
      "t1": 3.9,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 5.86,
      "t1": 8.32,
      "texto": "Aconteceu que, num dia de sábado,"
    },
    {
      "t0": 8.92,
      "t1": 12.22,
      "texto": "Jesus foi comer na casa de um dos chefes dos fariseus."
    },
    {
      "t0": 12.44,
      "t1": 14.6,
      "texto": "E eles o observavam."
    },
    {
      "t0": 15.6,
      "t1": 18.78,
      "texto": "Diante de Jesus, havia um hidrópico."
    },
    {
      "t0": 19.52,
      "t1": 20.72,
      "texto": "Tomando a palavra,"
    },
    {
      "t0": 21.38,
      "t1": 24.34,
      "texto": "Jesus falou aos mestres da Lei e aos fariseus:"
    },
    {
      "t0": 24.98,
      "t1": 28.82,
      "texto": "\"A Lei permite curar em dia de sábado, ou não?\""
    },
    {
      "t0": 29.42,
      "t1": 31.72,
      "texto": "Mas eles ficaram em silêncio."
    },
    {
      "t0": 32.54,
      "t1": 35.28,
      "texto": "Então Jesus tomou o homem pela mão,"
    },
    {
      "t0": 35.28,
      "t1": 38.3,
      "texto": "curou-o e despediu-o."
    },
    {
      "t0": 38.3,
      "t1": 39.78,
      "texto": "Depois lhes disse:"
    },
    {
      "t0": 40.62,
      "t1": 43.68,
      "texto": "\"Se algum de vós tem um filho ou um boi"
    },
    {
      "t0": 43.68,
      "t1": 45.06,
      "texto": "que caiu num poço,"
    },
    {
      "t0": 45.4,
      "t1": 48.14,
      "texto": "não o tira logo, mesmo em dia de sábado?\""
    },
    {
      "t0": 48.68,
      "t1": 51.88,
      "texto": "E eles não foram capazes de responder a isso."
    },
    {
      "t0": 52.94,
      "t1": 54.36,
      "texto": "Palavra da Salvação."
    }
  ]
}
