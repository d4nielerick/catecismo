      "texto": "Leitura da Carta de São Paulo aos Efésios."
    },
    {
      "t0": 4.22,
      "t1": 4.94,
      "texto": "Irmãos,"
    },
    {
      "t0": 5.2,
      "t1": 8.16,
      "texto": "eu, prisioneiro no Senhor, vos exorto"
    },
    {
      "t0": 8.16,
