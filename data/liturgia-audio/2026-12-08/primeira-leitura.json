      "texto": "Leitura do Livro do Gênesis."
    },
    {
      "t0": 1.84,
      "t1": 4.26,
      "texto": "O Senhor Deus chamou Adão, dizendo:"
    },
    {
      "t0": 4.5,
      "t1": 5.36,
      "texto": "\"Onde estás?\""
    },
    {
      "t0": 5.6,
      "t1": 6.78,
      "texto": "E ele respondeu:"
    },
    {
      "t0": 7.28,
      "t1": 8.68,
      "texto": "\"Ouvi tua voz no jardim,"
    },
    {
      "t0": 8.68,
      "t1": 10.52,
      "texto": "e fiquei com medo porque estava nu;"
    },
    {
      "t0": 10.68,
      "t1": 11.62,
      "texto": "e me escondi\"."
    },
    {
      "t0": 11.62,
      "t1": 13.28,
      "texto": "Disse-lhe o Senhor Deus:"
    },
    {
      "t0": 13.5,
      "t1": 15,
      "texto": "\"E quem te disse que estavas nu?"
    },
    {
      "t0": 15.32,
      "t1": 16.9,
      "texto": "Então comeste da árvore,"
    },
    {
      "t0": 16.9,
      "t1": 18.64,
      "texto": "de cujo fruto te proibi comer?\""
    },
    {
      "t0": 19.1,
      "t1": 19.94,
      "texto": "Adão disse:"
    },
    {
      "t0": 20.18,
      "t1": 22.34,
      "texto": "\"A mulher que tu me deste por companheira,"
    },
    {
      "t0": 22.34,
      "t1": 25.34,
      "texto": "foi ela que me deu do fruto da árvore, e eu comi\"."
    },
    {
      "t0": 25.74,
      "t1": 27.2,
      "texto": "Disse o Senhor Deus à mulher:"
    },
    {
      "t0": 27.56,
      "t1": 28.74,
      "texto": "\"Por que fizeste isso?\""
    },
    {
      "t0": 28.74,
      "t1": 30.18,
      "texto": "E a mulher respondeu:"
    },
    {
      "t0": 30.34,
      "t1": 32.36,
      "texto": "\"A serpente enganou-me e eu comi\"."
    },
    {
      "t0": 32.54,
      "t1": 34.74,
      "texto": "Então o Senhor Deus disse à serpente:"
    },
    {
      "t0": 34.74,
      "t1": 37.36,
      "texto": "\"Porque fizeste isso, serás maldita"
    },
    {
      "t0": 37.36,
      "t1": 39.2,
      "texto": "entre todos os animais domésticos"
    },
    {
      "t0": 39.2,
      "t1": 41.08,
      "texto": "e todos os animais selvagens!"
    },
    {
      "t0": 41.54,
      "t1": 42.88,
      "texto": "Rastejarás sobre o ventre"
    },
    {
      "t0": 42.88,
      "t1": 45.2,
      "texto": "e comerás pó todos os dias da tua vida!"
    },
    {
      "t0": 45.2,
      "t1": 47.7,
      "texto": "Porei inimizade entre ti e a mulher,"
    },
    {
      "t0": 48.02,
      "t1": 49.82,
      "texto": "entre a tua descendência e a dela."
    },
    {
      "t0": 50.2,
      "t1": 51.74,
      "texto": "Esta te ferirá a cabeça"
    },
    {
      "t0": 51.92,
      "t1": 53.6,
      "texto": "e tu lhe ferirás o calcanhar\"."
    },
    {
      "t0": 53.84,
      "t1": 55.98,
      "texto": "E Adão chamou à sua mulher \"Eva\","
    },
    {
      "t0": 56.3,
      "t1": 58.4,
      "texto": "porque ela é a mãe de todos os viventes."
    },
    {
      "t0": 58.4,
      "t1": 59.66,
      "texto": "Palavra do Senhor."
    }
  ]
