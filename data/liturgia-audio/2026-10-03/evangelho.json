{
  "referencia": "Lc 10,17-24",
  "voz": "Algenib (gemini-3.8-flash-tts)",
  "duracao": 100.5,
  "linhas": [
    {
      "t0": 0,
      "t1": 4.08,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 5.68,
      "t1": 6.74,
      "texto": "Naquele tempo,"
    },
    {
      "t0": 7.06,
      "t1": 9.98,
      "texto": "os setenta e dois voltaram muito contentes,"
    },
    {
      "t0": 10.14,
      "t1": 10.76,
      "texto": "dizendo:"
    },
    {
      "t0": 10.76,
      "t1": 14.72,
      "texto": "\"Senhor, até os demônios nos obedeceram"
    },
    {
      "t0": 14.72,
      "t1": 16.02,
      "texto": "por causa do teu nome\"."
    },
    {
      "t0": 17.3,
      "t1": 18.68,
      "texto": "Jesus respondeu:"
    },
    {
      "t0": 18.68,
      "t1": 23.08,
      "texto": "\"Eu vi Satanás cair do céu, como um relâmpago."
    },
    {
      "t0": 24.02,
      "t1": 25.24,
      "texto": "Eu vos dei o poder"
    },
    {
      "t0": 25.24,
      "t1": 28.34,
      "texto": "de pisar em cima de cobras e escorpiões"
    },
    {
      "t0": 28.34,
      "t1": 30.76,
      "texto": "e sobre toda a força do inimigo."
    },
    {
      "t0": 30.94,
      "t1": 33.26,
      "texto": "E nada vos poderá fazer mal."
    },
    {
      "t0": 34.14,
      "t1": 36.46,
      "texto": "Contudo, não vos alegreis"
    },
    {
      "t0": 36.6,
      "t1": 38.54,
      "texto": "porque os espíritos vos obedecem."
    },
    {
      "t0": 39.06,
      "t1": 42.62,
      "texto": "Antes, ficai alegres porque vossos nomes"
    },
    {
      "t0": 42.62,
      "t1": 44.18,
      "texto": "estão escritos no céu\"."
    },
    {
      "t0": 45.16,
      "t1": 46.36,
      "texto": "Naquele momento,"
    },
    {
      "t0": 46.8,
      "t1": 49.4,
      "texto": "Jesus exultou no Espírito Santo e disse:"
    },
    {
      "t0": 49.4,
      "t1": 51.56,
      "texto": "\"Eu te louvo, Pai,"
    },
    {
      "t0": 52.06,
      "t1": 53.38,
      "texto": "Senhor do céu e da terra,"
    },
    {
      "t0": 53.76,
      "t1": 55.5,
      "texto": "porque escondeste essas coisas"
    },
    {
      "t0": 55.5,
      "t1": 57.18,
      "texto": "aos sábios e inteligentes,"
    },
    {
      "t0": 57.18,
      "t1": 59.62,
      "texto": "e as revelaste aos pequeninos."
    },
    {
      "t0": 60.44,
      "t1": 63.64,
      "texto": "Sim, Pai, porque assim foi do teu agrado."
    },
    {
      "t0": 64.32,
      "t1": 66.42,
      "texto": "Tudo me foi entregue pelo meu Pai."
    },
    {
      "t0": 67.4,
      "t1": 69.3,
      "texto": "Ninguém conhece quem é o Filho,"
    },
    {
      "t0": 69.38,
      "t1": 70.32,
      "texto": "a não ser o Pai;"
    },
    {
      "t0": 70.72,
      "t1": 72.74,
      "texto": "e ninguém conhece quem é o Pai,"
    },
    {
      "t0": 72.88,
      "t1": 74.08,
      "texto": "a não ser o Filho"
    },
    {
      "t0": 74.2,
      "t1": 77.48,
      "texto": "e aquele a quem o Filho o quiser revelar\"."
    },
    {
      "t0": 78.44,
      "t1": 80.6,
      "texto": "Jesus voltou-se para os discípulos"
    },
    {
      "t0": 80.6,
      "t1": 82.06,
      "texto": "e disse-lhes em particular:"
    },
    {
      "t0": 82.98,
      "t1": 86.04,
      "texto": "\"Felizes os olhos que veem o que vós vedes!"
    },
    {
      "t0": 86.64,
      "t1": 87.88,
      "texto": "Pois eu vos digo"
    },
    {
      "t0": 87.88,
      "t1": 90.82,
      "texto": "que muitos profetas e reis quiseram ver"
    },
    {
      "t0": 90.82,
      "t1": 93.48,
      "texto": "o que estais vendo, e não puderam ver;"
    },
    {
      "t0": 94.12,
      "t1": 96.04,
      "texto": "quiseram ouvir o que estais ouvindo,"
    },
    {
      "t0": 96.04,
      "t1": 98,
      "texto": "e não puderam ouvir\"."
    },
    {
      "t0": 98,
      "t1": 100.5,
      "texto": "Palavra da Salvação."
    }
  ]
}
