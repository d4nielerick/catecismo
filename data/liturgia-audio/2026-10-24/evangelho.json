{
  "referencia": "Lc 13,1-9",
  "voz": "Daniel (ElevenLabs, v4)",
  "duracao": 87.2,
  "linhas": [
    {
      "t0": 0,
      "t1": 4.16,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 4.64,
      "t1": 7.2,
      "texto": "Naquele tempo, vieram algumas pessoas"
    },
    {
      "t0": 7.28,
      "t1": 8.88,
      "texto": "trazendo notícias a Jesus"
    },
    {
      "t0": 9.2,
      "t1": 10.56,
      "texto": "a respeito dos galileus"
    },
    {
      "t0": 10.6,
      "t1": 12.56,
      "texto": "que Pilatos tinha matado,"
    },
    {
      "t0": 12.68,
      "t1": 13.76,
      "texto": "misturando seu sangue"
    },
    {
      "t0": 14.08,
      "t1": 16.6,
      "texto": "com o dos sacrifícios que ofereciam."
    },
    {
      "t0": 17.04,
      "t1": 18.72,
      "texto": "Jesus lhes respondeu:"
    },
    {
      "t0": 19.04,
      "t1": 22.32,
      "texto": "\"Vós pensais que esses galileus eram mais pecadores"
    },
    {
      "t0": 22.36,
      "t1": 24.32,
      "texto": "do que todos os outros galileus,"
    },
    {
      "t0": 24.56,
      "t1": 26.68,
      "texto": "por terem sofrido tal coisa?"
    },
    {
      "t0": 27.04,
      "t1": 28.16,
      "texto": "Eu vos digo que não."
    },
    {
      "t0": 28.8,
      "t1": 30.96,
      "texto": "Mas se vós não vos converterdes,"
    },
    {
      "t0": 31.08,
      "t1": 33.36,
      "texto": "ireis morrer todos do mesmo modo."
    },
    {
      "t0": 34,
      "t1": 35.84,
      "texto": "E aqueles dezoito que morreram,"
    },
    {
      "t0": 35.88,
      "t1": 38.56,
      "texto": "quando a torre de Siloé caiu sobre eles?"
    },
    {
      "t0": 38.88,
      "t1": 40.56,
      "texto": "Pensais que eram mais culpados"
    },
    {
      "t0": 40.6,
      "t1": 43.44,
      "texto": "do que todos os outros moradores de Jerusalém?"
    },
    {
      "t0": 43.76,
      "t1": 45.2,
      "texto": "Eu vos digo que não."
    },
    {
      "t0": 45.52,
      "t1": 47.92,
      "texto": "Mas, se não vos converterdes,"
    },
    {
      "t0": 48,
      "t1": 50.96,
      "texto": "ireis morrer todos do mesmo modo\"."
    },
    {
      "t0": 51,
      "t1": 53.24,
      "texto": "E Jesus contou esta parábola:"
    },
    {
      "t0": 53.6,
      "t1": 55.36,
      "texto": "\"Certo homem tinha uma figueira"
    },
    {
      "t0": 55.44,
      "t1": 57.12,
      "texto": "plantada na sua vinha."
    },
    {
      "t0": 57.44,
      "t1": 60.24,
      "texto": "Foi até ela procurar figos e não encontrou."
    },
    {
      "t0": 60.8,
      "t1": 62.56,
      "texto": "Então disse ao vinhateiro:"
    },
    {
      "t0": 62.88,
      "t1": 64,
      "texto": "'Já faz três anos"
    },
    {
      "t0": 64.08,
      "t1": 66.16,
      "texto": "que venho procurando figos nesta figueira"
    },
    {
      "t0": 66.4,
      "t1": 67.6,
      "texto": "e nada encontro."
    },
    {
      "t0": 68,
      "t1": 71.04,
      "texto": "Corta-a! Por que está ela inutilizando a terra?'"
    },
    {
      "t0": 71.68,
      "t1": 73.04,
      "texto": "Ele, porém, respondeu:"
    },
    {
      "t0": 73.52,
      "t1": 76.48,
      "texto": "'Senhor, deixa a figueira ainda este ano."
    },
    {
      "t0": 76.88,
      "t1": 79.44,
      "texto": "Vou cavar em volta dela e colocar adubo."
    },
    {
      "t0": 79.92,
      "t1": 81.68,
      "texto": "Pode ser que venha a dar fruto."
    },
    {
      "t0": 82.08,
      "t1": 85.36,
      "texto": "Se não der, então tu a cortarás' \"."
    },
    {
      "t0": 85.52,
      "t1": 87.2,
      "texto": "Palavra da Salvação."
    }
  ]
}
