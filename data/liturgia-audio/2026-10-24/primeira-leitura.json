{
  "referencia": "Ef 4,7-16",
  "voz": "Daniel (ElevenLabs, v4)",
  "duracao": 95.76,
  "linhas": [
    {
      "t0": 0,
      "t1": 3.2,
      "texto": "Leitura da Carta de São Paulo aos Efésios."
    },
    {
      "t0": 3.52,
      "t1": 4.36,
      "texto": "Irmãos,"
    },
    {
      "t0": 4.64,
      "t1": 6.56,
      "texto": "cada um de nós recebeu a graça"
    },
    {
      "t0": 6.64,
      "t1": 8.72,
      "texto": "na medida em que Cristo lha deu."
    },
    {
      "t0": 9.04,
      "t1": 10.24,
      "texto": "Daí esta palavra:"
    },
    {
      "t0": 10.72,
      "t1": 12.48,
      "texto": "\"Tendo subido às alturas,"
    },
    {
      "t0": 12.56,
      "t1": 14.12,
      "texto": "ele capturou prisioneiros,"
    },
    {
      "t0": 14.24,
      "t1": 16.32,
      "texto": "e distribuiu dons aos homens\"."
    },
    {
      "t0": 16.88,
      "t1": 17.76,
      "texto": "\"Ele subiu\"!"
    },
    {
      "t0": 18.24,
      "t1": 19.36,
      "texto": "Que significa isso,"
    },
    {
      "t0": 19.6,
      "t1": 21.12,
      "texto": "senão que ele desceu também"
    },
    {
      "t0": 21.16,
      "t1": 22.64,
      "texto": "às profundezas da terra?"
    },
    {
      "t0": 23.36,
      "t1": 25.84,
      "texto": "Aquele que desceu é o mesmo que subiu"
    },
    {
      "t0": 25.92,
      "t1": 28,
      "texto": "mais alto do que todos os céus,"
    },
    {
      "t0": 28.24,
      "t1": 30.08,
      "texto": "a fim de encher o universo."
    },
    {
      "t0": 30.64,
      "t1": 34.08,
      "texto": "E foi ele quem instituiu alguns como apóstolos,"
    },
    {
      "t0": 34.16,
      "t1": 35.84,
      "texto": "outros como profetas,"
    },
    {
      "t0": 35.92,
      "t1": 38.08,
      "texto": "outros ainda como evangelistas,"
    },
    {
      "t0": 38.2,
      "t1": 41.64,
      "texto": "outros, enfim, como pastores e mestres."
    },
    {
      "t0": 41.92,
      "t1": 45.28,
      "texto": "Assim, ele capacitou os santos para o ministério,"
    },
    {
      "t0": 45.36,
      "t1": 47.44,
      "texto": "para edificar o corpo de Cristo,"
    },
    {
      "t0": 47.52,
      "t1": 50.72,
      "texto": "até que cheguemos todos juntos à unidade da fé"
    },
    {
      "t0": 51.04,
      "t1": 53.12,
      "texto": "e do conhecimento do Filho de Deus,"
    },
    {
      "t0": 53.44,
      "t1": 55.2,
      "texto": "ao estado do homem perfeito"
    },
    {
      "t0": 55.52,
      "t1": 58.68,
      "texto": "e à estatura de Cristo em sua plenitude."
    },
    {
      "t0": 58.96,
      "t1": 61.12,
      "texto": "Assim, não seremos mais crianças"
    },
    {
      "t0": 61.16,
      "t1": 62.64,
      "texto": "ao sabor das ondas,"
    },
    {
      "t0": 62.72,
      "t1": 65.52,
      "texto": "arrastados por todo vento de doutrina,"
    },
    {
      "t0": 65.6,
      "t1": 67.12,
      "texto": "ludibriados pelos homens"
    },
    {
      "t0": 67.36,
      "t1": 70.24,
      "texto": "e induzidos por sua astúcia ao erro."
    },
    {
      "t0": 70.56,
      "t1": 71.68,
      "texto": "Motivados pelo amor"
    },
    {
      "t0": 72.08,
      "t1": 73.76,
      "texto": "queremos ater-nos à verdade"
    },
    {
      "t0": 74,
      "t1": 76.88,
      "texto": "e crescer em tudo até atingirmos aquele"
    },
    {
      "t0": 76.96,
      "t1": 79.2,
      "texto": "que é a Cabeça, Cristo."
    },
    {
      "t0": 79.52,
      "t1": 80.56,
      "texto": "Graças a ele,"
    },
    {
      "t0": 80.64,
      "t1": 83.36,
      "texto": "o corpo, coordenado e bem unido,"
    },
    {
      "t0": 83.52,
      "t1": 86.56,
      "texto": "por meio de todas as articulações que o servem,"
    },
    {
      "t0": 86.72,
      "t1": 88.4,
      "texto": "realiza o seu crescimento,"
    },
    {
      "t0": 88.48,
      "t1": 91.6,
      "texto": "segundo uma atividade à medida de cada membro,"
    },
    {
      "t0": 91.68,
      "t1": 94,
      "texto": "para a sua edificação no amor."
    },
    {
      "t0": 94.32,
      "t1": 95.76,
      "texto": "Palavra do Senhor."
    }
  ]
}
