    {
      "t0": 0,
      "t1": 3.16,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 3.16,
      "t1": 7.06,
      "texto": "Naquela hora, alguns fariseus aproximaram-se"
    },
    {
      "t0": 7.06,
      "t1": 8.18,
      "texto": "e disseram a Jesus:"
    },
    {
      "t0": 8.5,
      "t1": 10.22,
      "texto": "\"Tu deves ir embora daqui,"
    },
    {
      "t0": 10.44,
      "t1": 12.14,
      "texto": "porque Herodes quer te matar\"."
    },
    {
      "t0": 12.66,
      "t1": 13.68,
      "texto": "Jesus disse:"
    },
    {
      "t0": 13.68,
      "t1": 16.02,
      "texto": "\"Ide dizer a essa raposa:"
    },
    {
      "t0": 16.28,
      "t1": 17.64,
      "texto": "eu expulso demônios"
    },
    {
      "t0": 17.64,
      "t1": 19.86,
      "texto": "e faço curas hoje e amanhã;"
    },
    {
      "t0": 19.96,
      "t1": 22.88,
      "texto": "e no terceiro dia terminarei o meu trabalho."
    },
    {
      "t0": 23.58,
      "t1": 25.92,
      "texto": "Entretanto, preciso caminhar hoje,"
    },
    {
      "t0": 26.14,
      "t1": 28.04,
      "texto": "amanhã e depois de amanhã,"
    },
    {
      "t0": 28.04,
      "t1": 29.54,
      "texto": "porque não convém"
    },
    {
      "t0": 29.54,
      "t1": 31.62,
      "texto": "que um profeta morra fora de Jerusalém."
    },
    {
      "t0": 32.24,
      "t1": 33.92,
      "texto": "Jerusalém, Jerusalém!"
    },
    {
      "t0": 34.43,
      "t1": 36.08,
      "texto": "Tu que matas os profetas"
    },
    {
      "t0": 36.08,
      "t1": 38.44,
      "texto": "e apedrejas os que te foram enviados!"
    },
    {
      "t0": 39.14,
      "t1": 41.68,
      "texto": "Quantas vezes eu quis reunir teus filhos,"
    },
    {
      "t0": 41.86,
      "t1": 45.14,
      "texto": "como a galinha reúne os pintainhos debaixo das asas,"
    },
    {
      "t0": 45.36,
      "t1": 46.88,
      "texto": "mas tu não quiseste!"
    },
    {
      "t0": 47.48,
      "t1": 49.78,
      "texto": "Eis que vossa casa ficará abandonada."
    },
    {
      "t0": 49.98,
      "t1": 52.58,
      "texto": "Eu vos digo: não me vereis mais,"
    },
    {
      "t0": 52.74,
      "t1": 55.78,
      "texto": "até que chegue o tempo em que vós mesmos direis:"
    },
    {
      "t0": 55.78,
      "t1": 59.54,
      "texto": "'Bendito aquele que vem em nome do Senhor' \"."
    },
    {
      "t0": 59.54,
      "t1": 60.78,
      "texto": "Palavra da Salvação."
    }
  ]
