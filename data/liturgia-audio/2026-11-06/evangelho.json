{
  "referencia": "Lc 16,1-8",
  "voz": "Algenib (gemini-3.8-flash-tts)",
  "duracao": 89.2,
  "linhas": [
    {
      "t0": 0,
      "t1": 3.94,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 3.94,
      "t1": 5.6,
      "texto": "Naquele tempo,"
    },
    {
      "t0": 5.94,
      "t1": 7.72,
      "texto": "Jesus disse aos discípulos:"
    },
    {
      "t0": 8.44,
      "t1": 11.02,
      "texto": "\"Um homem rico tinha um administrador"
    },
    {
      "t0": 11.14,
      "t1": 13.88,
      "texto": "que foi acusado de esbanjar os seus bens."
    },
    {
      "t0": 14.26,
      "t1": 16.12,
      "texto": "Ele o chamou e lhe disse:"
    },
    {
      "t0": 16.64,
      "t1": 18.76,
      "texto": "'Que é isto que ouço a teu respeito?"
    },
    {
      "t0": 19.2,
      "t1": 21.32,
      "texto": "Presta contas da tua administração,"
    },
    {
      "t0": 21.62,
      "t1": 24.42,
      "texto": "pois já não podes mais administrar meus bens'."
    },
    {
      "t0": 24.86,
      "t1": 27.76,
      "texto": "O administrador então começou a refletir:"
    },
    {
      "t0": 27.76,
      "t1": 30.68,
      "texto": "'O senhor vai me tirar a administração."
    },
    {
      "t0": 31.66,
      "t1": 32.22,
      "texto": "Que vou fazer?"
    },
    {
      "t0": 32.8,
      "t1": 34.88,
      "texto": "Para cavar, não tenho forças;"
    },
    {
      "t0": 35.18,
      "t1": 37.08,
      "texto": "de mendigar, tenho vergonha."
    },
    {
      "t0": 37.74,
      "t1": 39.42,
      "texto": "Ah! Já sei o que fazer,"
    },
    {
      "t0": 39.72,
      "t1": 41.92,
      "texto": "para que alguém me receba em sua casa"
    },
    {
      "t0": 41.92,
      "t1": 44.54,
      "texto": "quando eu for afastado da administração'."
    },
    {
      "t0": 45.12,
      "t1": 47,
      "texto": "Então ele chamou cada um"
    },
    {
      "t0": 47,
      "t1": 48.86,
      "texto": "dos que estavam devendo ao seu patrão."
    },
    {
      "t0": 49.08,
      "t1": 50.62,
      "texto": "E perguntou ao primeiro:"
    },
    {
      "t0": 50.98,
      "t1": 52.7,
      "texto": "'Quanto deves ao meu patrão?'"
    },
    {
      "t0": 53.08,
      "t1": 55.94,
      "texto": "Ele respondeu: 'Cem barris de óleo!'"
    },
    {
      "t0": 55.94,
      "t1": 57.9,
      "texto": "O administrador disse:"
    },
    {
      "t0": 58.18,
      "t1": 60.94,
      "texto": "'Pega a tua conta, senta-te, depressa,"
    },
    {
      "t0": 61.06,
      "t1": 62.2,
      "texto": "e escreve cinquenta!'"
    },
    {
      "t0": 62.82,
      "t1": 64.42,
      "texto": "Depois ele perguntou a outro:"
    },
    {
      "t0": 64.84,
      "t1": 66.4,
      "texto": "'E tu, quanto deves?'"
    },
    {
      "t0": 66.8,
      "t1": 67.88,
      "texto": "Ele respondeu:"
    },
    {
      "t0": 67.88,
      "t1": 69.6,
      "texto": "'Cem medidas de trigo'."
    },
    {
      "t0": 70.12,
      "t1": 72.08,
      "texto": "O administrador disse:"
    },
    {
      "t0": 72.36,
      "t1": 74.8,
      "texto": "'Pega tua conta e escreve oitenta'."
    },
    {
      "t0": 75.36,
      "t1": 78.5,
      "texto": "E o senhor elogiou o administrador desonesto,"
    },
    {
      "t0": 78.7,
      "t1": 80.42,
      "texto": "porque ele agiu com esperteza."
    },
    {
      "t0": 80.92,
      "t1": 83.14,
      "texto": "Com efeito, os filhos deste mundo"
    },
    {
      "t0": 83.32,
      "t1": 85.4,
      "texto": "são mais espertos em seus negócios"
    },
    {
      "t0": 85.54,
      "t1": 86.86,
      "texto": "do que os filhos da luz\"."
    },
    {
      "t0": 86.86,
      "t1": 89.2,
      "texto": "Palavra da Salvação."
    }
  ]
}
