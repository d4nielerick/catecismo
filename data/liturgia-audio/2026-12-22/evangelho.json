  "linhas": [
    {
      "t0": 0,
      "t1": 3.28,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 3.82,
      "t1": 4.8,
      "texto": "Naquele tempo,"
    },
    {
      "t0": 5.02,
      "t1": 5.74,
      "texto": "Maria disse:"
    },
    {
      "t0": 6,
      "t1": 8.12,
      "texto": "\"A minha alma engrandece o Senhor,"
    },
    {
      "t0": 8.3,
      "t1": 11.08,
      "texto": "e o meu espírito se alegra em Deus, meu Salvador,"
    },
    {
      "t0": 11.6,
      "t1": 14.06,
      "texto": "porque olhou para a humildade de sua serva."
    },
    {
      "t0": 14.62,
      "t1": 18.02,
      "texto": "Doravante todas as gerações me chamarão bem-aventurada,"
    },
    {
      "t0": 18.02,
      "t1": 19.42,
      "texto": "porque o Todo-poderoso"
    },
    {
      "t0": 19.42,
      "t1": 21.24,
      "texto": "fez grandes coisas em meu favor."
    },
    {
      "t0": 21.5,
      "t1": 22.88,
      "texto": "O seu nome é santo,"
    },
    {
      "t0": 23.1,
      "t1": 26.5,
      "texto": "e sua misericórdia se estende, de geração em geração,"
    },
    {
      "t0": 26.64,
      "t1": 28.1,
      "texto": "a todos os que o temem."
    },
    {
      "t0": 28.1,
      "t1": 30.5,
      "texto": "Ele mostrou a força de seu braço:"
    },
    {
      "t0": 30.72,
      "t1": 32.64,
      "texto": "dispersou os soberbos de coração."
    },
    {
      "t0": 33.2,
      "t1": 34.88,
      "texto": "Derrubou do trono os poderosos"
    },
    {
      "t0": 34.88,
      "t1": 36.26,
      "texto": "e elevou os humildes."
    },
    {
      "t0": 36.7,
      "t1": 38.2,
      "texto": "Encheu de bens os famintos,"
    },
    {
      "t0": 38.32,
      "t1": 40.5,
      "texto": "e despediu os ricos de mãos vazias."
    },
    {
      "t0": 40.94,
      "t1": 42.7,
      "texto": "Socorreu Israel, seu servo,"
    },
    {
      "t0": 42.7,
      "t1": 44.76,
      "texto": "lembrando-se de sua misericórdia,"
    },
    {
      "t0": 44.98,
      "t1": 47.02,
      "texto": "conforme prometera aos nossos pais,"
    },
    {
      "t0": 47.22,
      "t1": 50.34,
      "texto": "em favor de Abraão e de sua descendência, para sempre\"."
    },
    {
      "t0": 50.76,
      "t1": 53,
      "texto": "Maria ficou três meses com Isabel;"
    },
    {
      "t0": 53.28,
      "t1": 54.7,
      "texto": "depois voltou para casa."
    },
    {
      "t0": 55.02,
      "t1": 56.3,
      "texto": "Palavra da Salvação."
    }
  ]
