      "t0": 8.88,
      "t1": 10.4,
      "texto": "ouvi Israel, vosso pai!"
    },
    {
      "t0": 10.92,
      "t1": 13.16,
      "texto": "Judá, teus irmãos te louvarão;"
    },
    {
      "t0": 13.54,
      "t1": 16.24,
      "texto": "pesará tua mão sobre a nuca de teus inimigos,"
    },
    {
      "t0": 16.48,
