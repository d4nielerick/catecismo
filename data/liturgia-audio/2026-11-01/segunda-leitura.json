  "duracao": 38.56,
  "linhas": [
    {
      "t0": 0,
      "t1": 2.56,
      "texto": "Leitura da Primeira Carta de São João."
    },
    {
      "t0": 3.12,
      "t1": 4.32,
      "texto": "Caríssimos,"
    },
    {
      "t0": 4.4,
      "t1": 7.92,
      "texto": "vede que grande presente de amor o Pai nos deu:"
    },
    {
      "t0": 8,
      "t1": 10.6,
      "texto": "de sermos chamados filhos de Deus!"
    },
    {
      "t0": 10.8,
      "t1": 12.44,
      "texto": "E nós o somos!"
    },
    {
      "t0": 12.72,
      "t1": 14.48,
      "texto": "Se o mundo não nos conhece,"
    },
    {
      "t0": 14.56,
      "t1": 16.64,
      "texto": "é porque não conheceu o Pai."
    },
    {
      "t0": 16.96,
      "t1": 20.72,
      "texto": "Caríssimos, desde já somos filhos de Deus,"
    },
    {
      "t0": 20.84,
      "t1": 23.56,
      "texto": "mas nem sequer se manifestou o que seremos!"
    },
    {
      "t0": 23.84,
      "t1": 24.88,
      "texto": "Sabemos que,"
    },
    {
      "t0": 24.92,
      "t1": 26.8,
      "texto": "quando Jesus se manifestar,"
    },
    {
      "t0": 26.88,
      "t1": 28.48,
      "texto": "seremos semelhantes a ele,"
    },
    {
      "t0": 28.8,
      "t1": 30.88,
      "texto": "porque o veremos tal como ele é."
    },
    {
      "t0": 31.52,
      "t1": 33.04,
      "texto": "Todo o que espera nele,"
    },
    {
      "t0": 33.12,
      "t1": 34.8,
      "texto": "purifica-se a si mesmo,"
    },
    {
      "t0": 34.88,
      "t1": 36.56,
      "texto": "como também ele é puro."
    },
    {
      "t0": 37.12,
      "t1": 38.56,
      "texto": "Palavra do Senhor."
    }
  ]
}
