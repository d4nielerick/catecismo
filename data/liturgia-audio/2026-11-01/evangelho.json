      "texto": "vendo Jesus as multidões,"
    },
    {
      "t0": 7.88,
      "t1": 9.76,
      "texto": "subiu ao monte e sentou-se."
    },
    {
      "t0": 10.4,
      "t1": 12.08,
      "texto": "Os discípulos aproximaram-se,"
    },
    {
      "t0": 12.4,
      "t1": 14.4,
      "texto": "e Jesus começou a ensiná-los:"
    },
    {
      "t0": 15.04,
      "t1": 17.92,
      "texto": "\"Bem-aventurados os pobres em espírito,"
    },
    {
      "t0": 18,
      "t1": 20.6,
      "texto": "porque deles é o Reino dos Céus."
    },
    {
      "t0": 20.96,
      "t1": 22.72,
      "texto": "Bem-aventurados os aflitos,"
    },
    {
      "t0": 22.96,
      "t1": 24.84,
      "texto": "porque serão consolados."
    },
    {
      "t0": 25.2,
      "t1": 26.88,
      "texto": "Bem-aventurados os mansos,"
    },
    {
      "t0": 27.2,
      "t1": 29.2,
      "texto": "porque possuirão a terra."
    },
    {
      "t0": 29.6,
      "t1": 33.12,
      "texto": "Bem-aventurados os que têm fome e sede de justiça,"
    },
    {
      "t0": 33.44,
      "t1": 34.96,
      "texto": "porque serão saciados."
    },
    {
      "t0": 35.68,
      "t1": 38.08,
      "texto": "Bem-aventurados os misericordiosos,"
    },
    {
      "t0": 38.32,
      "t1": 40.24,
      "texto": "porque alcançarão misericórdia."
    },
    {
      "t0": 40.88,
      "t1": 43.28,
      "texto": "Bem-aventurados os puros de coração,"
    },
    {
      "t0": 43.52,
      "t1": 45.16,
      "texto": "porque verão a Deus."
    },
    {
      "t0": 45.52,
      "t1": 47.92,
      "texto": "Bem-aventurados os que promovem a paz,"
    },
    {
      "t0": 48.16,
      "t1": 50.84,
      "texto": "porque serão chamados filhos de Deus."
    },
    {
      "t0": 51.2,
      "t1": 53.68,
      "texto": "Bem-aventurados os que são perseguidos"
    },
    {
      "t0": 53.76,
      "t1": 55.36,
      "texto": "por causa da justiça,"
    },
    {
      "t0": 55.44,
      "t1": 58.16,
      "texto": "porque deles é o Reino dos Céus."
    },
    {
      "t0": 58.48,
      "t1": 61.76,
      "texto": "Bem-aventurados sois vós, quando vos injuriarem"
    },
    {
      "t0": 61.84,
      "t1": 64.16,
      "texto": "e perseguirem, e mentindo,"
    },
    {
      "t0": 64.28,
      "t1": 66.88,
      "texto": "disserem todo tipo de mal contra vós,"
    },
    {
      "t0": 66.96,
      "t1": 68.16,
      "texto": "por causa de mim."
    },
    {
      "t0": 68.48,
      "t1": 70.64,
      "texto": "Alegrai-vos e exultai,"
    },
    {
      "t0": 70.72,
