{
  "referencia": "1Ts 5,1-6",
  "voz": "Algenib (gemini-3.8-flash-tts)",
  "duracao": 47.98,
  "linhas": [
    {
      "t0": 0.2,
      "t1": 4.82,
      "texto": "Leitura da Primeira Carta de São Paulo aos Tessalonicenses."
    },
    {
      "t0": 4.82,
      "t1": 7.2,
      "texto": "Quanto ao tempo e à hora, meus irmãos,"
    },
    {
      "t0": 7.5,
      "t1": 8.92,
      "texto": "não há por que vos escrever."
    },
    {
      "t0": 9.64,
      "t1": 12.2,
      "texto": "Vós mesmos sabeis perfeitamente"
    },
    {
      "t0": 12.2,
      "t1": 15.4,
      "texto": "que o dia do Senhor virá como ladrão, de noite."
    },
    {
      "t0": 15.74,
      "t1": 18.7,
      "texto": "Quando as pessoas disserem: \"Paz e segurança!\","
    },
    {
      "t0": 19.02,
      "t1": 21.74,
      "texto": "então de repente sobrevirá a destruição,"
    },
    {
      "t0": 22.16,
      "t1": 24.84,
      "texto": "como as dores de parto sobre a mulher grávida."
    },
    {
      "t0": 24.86,
      "t1": 26.88,
      "texto": "E não poderão escapar."
    },
    {
      "t0": 27.48,
      "t1": 30.54,
      "texto": "Mas vós, meus irmãos, não estais nas trevas,"
    },
    {
      "t0": 30.82,
      "t1": 33.52,
      "texto": "de modo que esse dia vos surpreenda como um ladrão."
    },
    {
      "t0": 34.16,
      "t1": 37.4,
      "texto": "Todos vós sois filhos da luz e filhos do dia."
    },
    {
      "t0": 37.4,
      "t1": 40.2,
      "texto": "Não somos da noite, nem das trevas."
    },
    {
      "t0": 40.62,
      "t1": 43.18,
      "texto": "Portanto, não durmamos, como os outros,"
    },
    {
      "t0": 43.58,
      "t1": 46.18,
      "texto": "mas sejamos vigilantes e sóbrios."
    },
    {
      "t0": 46.86,
      "t1": 47.98,
      "texto": "Palavra do Senhor."
    }
  ]
}
