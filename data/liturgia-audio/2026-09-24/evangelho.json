  "linhas": [
    {
      "t0": 0,
      "t1": 4.16,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 4.32,
      "t1": 5.47,
      "texto": "Naquele tempo,"
    },
    {
      "t0": 5.62,
      "t1": 8.38,
      "texto": "o tetrarca Herodes ouviu falar"
    },
    {
      "t0": 8.53,
      "t1": 10.94,
      "texto": "de tudo o que estava acontecendo,"
    },
    {
      "t0": 11.09,
      "t1": 13.76,
      "texto": "e ficou perplexo, porque alguns diziam"
    },
    {
      "t0": 13.93,
      "t1": 18.09,
      "texto": "que João Batista tinha ressuscitado dos mortos."
    },
    {
      "t0": 18.25,
      "t1": 21.43,
      "texto": "Outros diziam que Elias tinha aparecido;"
    },
    {
      "t0": 21.56,
      "t1": 22.85,
      "texto": "outros ainda,"
    },
    {
      "t0": 23,
      "t1": 26.13,
      "texto": "que um dos antigos profetas tinha ressuscitado."
    },
    {
      "t0": 26.28,
      "t1": 28.23,
      "texto": "Então Herodes disse:"
    },
    {
      "t0": 28.4,
      "t1": 30.41,
      "texto": "\"Eu mandei degolar João."
    },
    {
      "t0": 30.56,
      "t1": 31.85,
      "texto": "Quem é esse homem,"
    },
    {
      "t0": 32,
      "t1": 34.51,
      "texto": "sobre quem ouço falar essas coisas?\""
    },
    {
      "t0": 34.67,
      "t1": 36.76,
      "texto": "E procurava ver Jesus."
    },
    {
      "t0": 36.9,
      "t1": 39.04,
      "texto": "Palavra da Salvação."
    }
  ]
}
