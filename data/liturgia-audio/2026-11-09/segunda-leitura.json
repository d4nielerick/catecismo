  "duracao": 52.68,
  "linhas": [
    {
      "t0": 0,
      "t1": 3.42,
      "texto": "Leitura da Primeira Carta de São Paulo aos Coríntios."
    },
    {
      "t0": 4.62,
      "t1": 5.22,
      "texto": "Irmãos,"
    },
    {
      "t0": 5.78,
      "t1": 9.24,
      "texto": "vós sois lavoura de Deus, construção de Deus."
    },
    {
      "t0": 10.2,
      "t1": 12.1,
      "texto": "Segundo a graça que Deus me deu,"
    },
    {
      "t0": 12.82,
      "t1": 13.6,
      "texto": "eu coloquei"
    },
    {
      "t0": 13.6,
      "t1": 16.64,
      "texto": "— como experiente mestre de obra —"
    },
    {
      "t0": 16.64,
      "t1": 17.5,
      "texto": "o alicerce,"
    },
    {
      "t0": 17.82,
      "t1": 20.38,
      "texto": "sobre o qual outros se põem a construir."
    },
    {
      "t0": 21.34,
      "t1": 24.26,
      "texto": "Mas cada qual veja bem como está construindo."
    },
    {
      "t0": 24.26,
      "t1": 28.62,
      "texto": "De fato, ninguém pode colocar outro alicerce"
    },
    {
      "t0": 28.82,
      "t1": 31.62,
      "texto": "diferente do que está aí, já colocado:"
    },
    {
      "t0": 32.16,
      "t1": 33.48,
      "texto": "Jesus Cristo."
    },
    {
      "t0": 34.38,
      "t1": 37.34,
      "texto": "Acaso não sabeis que sois santuário de Deus"
    },
    {
      "t0": 37.54,
      "t1": 40.48,
      "texto": "e que o Espírito de Deus mora em vós?"
    },
    {
      "t0": 41.23,
      "t1": 43.54,
      "texto": "Se alguém destruir o santuário de Deus,"
    },
    {
      "t0": 44.12,
      "t1": 45.18,
      "texto": "Deus o destruirá,"
    },
    {
      "t0": 45.56,
      "t1": 47.98,
      "texto": "pois o santuário de Deus é santo,"
    },
    {
      "t0": 48.3,
      "t1": 50.56,
      "texto": "e vós sois esse santuário."
    },
    {
      "t0": 51.42,
      "t1": 52.68,
      "texto": "Palavra do Senhor."
    }
  ]
}
