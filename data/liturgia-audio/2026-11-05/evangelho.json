{
  "referencia": "Lc 15,1-10",
  "voz": "Daniel (ElevenLabs, v4)",
  "duracao": 84.24,
  "linhas": [
    {
      "t0": 0,
      "t1": 3.76,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 4.08,
      "t1": 5.2,
      "texto": "Naquele tempo,"
    },
    {
      "t0": 5.28,
      "t1": 6.8,
      "texto": "os publicanos e pecadores"
    },
    {
      "t0": 6.88,
      "t1": 9.68,
      "texto": "aproximavam-se de Jesus para o escutar."
    },
    {
      "t0": 10,
      "t1": 11.44,
      "texto": "Os fariseus, porém,"
    },
    {
      "t0": 11.47,
      "t1": 14.56,
      "texto": "e os mestres da Lei criticavam Jesus."
    },
    {
      "t0": 14.88,
      "t1": 16.88,
      "texto": "\"Este homem acolhe os pecadores"
    },
    {
      "t0": 17.12,
      "t1": 18.8,
      "texto": "e faz refeição com eles\"."
    },
    {
      "t0": 19.52,
      "t1": 22.16,
      "texto": "Então Jesus contou-lhes esta parábola:"
    },
    {
      "t0": 22.8,
      "t1": 25.76,
      "texto": "\"Se um de vós tem cem ovelhas e perde uma,"
    },
    {
      "t0": 26.24,
      "t1": 28.56,
      "texto": "não deixa as noventa e nove no deserto,"
    },
    {
      "t0": 28.72,
      "t1": 30.84,
      "texto": "e vai atrás daquela que se perdeu,"
    },
    {
      "t0": 30.96,
      "t1": 32.08,
      "texto": "até encontrá-la?"
    },
    {
      "t0": 32.8,
      "t1": 33.92,
      "texto": "Quando a encontra,"
    },
    {
      "t0": 34,
      "t1": 36,
      "texto": "coloca-a nos ombros com alegria,"
    },
    {
      "t0": 36.32,
      "t1": 37.6,
      "texto": "e, chegando a casa,"
    },
    {
      "t0": 37.68,
      "t1": 39.23,
      "texto": "reúne os amigos e vizinhos,"
    },
    {
      "t0": 39.25,
      "t1": 39.76,
      "texto": "e diz:"
    },
    {
      "t0": 40.16,
      "t1": 41.44,
      "texto": "'Alegrai-vos comigo!"
    },
    {
      "t0": 41.76,
      "t1": 44.4,
      "texto": "Encontrei a minha ovelha que estava perdida!'"
    },
    {
      "t0": 45.12,
      "t1": 45.84,
      "texto": "Eu vos digo:"
    },
    {
      "t0": 46.4,
      "t1": 48.96,
      "texto": "Assim haverá no céu mais alegria"
    },
    {
      "t0": 49.04,
      "t1": 51.32,
      "texto": "por um só pecador que se converte,"
    },
    {
      "t0": 51.52,
      "t1": 53.52,
      "texto": "do que por noventa e nove justos"
    },
    {
      "t0": 53.76,
      "t1": 55.68,
      "texto": "que não precisam de conversão."
    },
    {
      "t0": 56.56,
      "t1": 58.8,
      "texto": "E se uma mulher tem dez moedas de prata"
    },
    {
      "t0": 58.96,
      "t1": 60.16,
      "texto": "e perde uma,"
    },
    {
      "t0": 60.2,
      "t1": 61.68,
      "texto": "não acende uma lâmpada,"
    },
    {
      "t0": 61.84,
      "t1": 66.08,
      "texto": "varre a casa e a procura cuidadosamente, até encontrá-la?"
    },
    {
      "t0": 66.72,
      "t1": 67.76,
      "texto": "Quando a encontra,"
    },
    {
      "t0": 67.84,
      "t1": 69.92,
      "texto": "reúne as amigas e vizinhas, e diz:"
    },
    {
      "t0": 70.24,
      "t1": 71.6,
      "texto": "'Alegrai-vos comigo!"
    },
    {
      "t0": 71.92,
      "t1": 74.48,
      "texto": "Encontrei a moeda que tinha perdido!'"
    },
    {
      "t0": 74.8,
      "t1": 76.32,
      "texto": "Por isso, eu vos digo,"
    },
    {
      "t0": 76.8,
      "t1": 79.04,
      "texto": "haverá alegria entre os anjos de Deus"
    },
    {
      "t0": 79.36,
      "t1": 81.68,
      "texto": "por um só pecador que se converte\"."
    },
    {
      "t0": 82.4,
      "t1": 84.24,
      "texto": "Palavra da Salvação."
    }
  ]
}
