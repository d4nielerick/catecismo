    {
      "t0": 0,
      "t1": 3.28,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo João."
    },
    {
      "t0": 3.28,
      "t1": 5.94,
      "texto": "Surgiu um homem enviado por Deus;"
    },
    {
      "t0": 6.24,
      "t1": 7.4,
      "texto": "Seu nome era João."
    },
    {
      "t0": 7.84,
      "t1": 9.54,
      "texto": "Ele veio como testemunha,"
    },
    {
      "t0": 9.74,
