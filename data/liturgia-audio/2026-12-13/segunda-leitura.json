{
  "referencia": "1Ts 5,16-24",
  "voz": "leo (Grok TTS)",
  "duracao": 41.02,
  "linhas": [
    {
      "t0": 0,
      "t1": 3.52,
      "texto": "Leitura da Primeira Carta de São Paulo aos Tessalonicenses."
    },
    {
      "t0": 3.52,
      "t1": 4.56,
      "texto": "Irmãos:"
    },
    {
      "t0": 4.56,
      "t1": 6.26,
      "texto": "Estai sempre alegres!"
    },
    {
      "t0": 6.26,
      "t1": 7.7,
      "texto": "Rezai sem cessar."
    },
    {
      "t0": 8.16,
      "t1": 10.24,
      "texto": "Dai graças em todas as circunstâncias,"
    },
    {
      "t0": 10.5,
      "t1": 12.18,
      "texto": "porque essa é a vosso respeito"
    },
    {
      "t0": 12.18,
      "t1": 14.14,
      "texto": "a vontade de Deus em Jesus Cristo."
    },
    {
      "t0": 14.48,
      "t1": 16.08,
      "texto": "Não apagueis o espírito!"
    },
    {
      "t0": 16.4,
      "t1": 18.12,
      "texto": "Não desprezeis as profecias,"
    },
    {
      "t0": 18.4,
      "t1": 21.18,
      "texto": "mas examinai tudo e guardai o que for bom."
    },
    {
      "t0": 21.18,
      "t1": 23.96,
      "texto": "Afastai-vos de toda espécie de maldade!"
    },
    {
      "t0": 24.2,
      "t1": 27.04,
      "texto": "Que o próprio Deus da paz vos santifique totalmente,"
    },
    {
      "t0": 27.04,
      "t1": 29.06,
      "texto": "e que tudo aquilo que sois"
    },
    {
      "t0": 29.06,
      "t1": 31.32,
      "texto": "— espírito, alma, corpo —"
    },
    {
      "t0": 31.32,
      "t1": 33.36,
      "texto": "seja conservado sem mancha alguma"
    },
    {
      "t0": 33.36,
      "t1": 35.7,
      "texto": "para a vinda de nosso Senhor Jesus Cristo!"
    },
    {
      "t0": 35.96,
      "t1": 37.84,
      "texto": "Aquele que vos chamou é fiel;"
    },
    {
      "t0": 38.22,
      "t1": 39.8,
      "texto": "ele mesmo realizará isso."
    },
    {
      "t0": 40.1,
      "t1": 41.02,
      "texto": "Palavra do Senhor."
    }
  ]
}
