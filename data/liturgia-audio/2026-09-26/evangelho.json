    },
    {
      "t0": 9.3,
      "t1": 11.44,
      "texto": "Então Jesus disse a seus discípulos:"
    },
    {
      "t0": 11.82,
      "t1": 14.77,
      "texto": "\"Prestai bem atenção às palavras que vou dizer:"
    },
    {
      "t0": 15.09,
      "t1": 17.86,
      "texto": "O Filho do Homem vai ser entregue nas mãos dos homens\"."
    },
    {
      "t0": 18.3,
      "t1": 21.4,
      "texto": "Mas os discípulos não compreendiam o que Jesus dizia."
    },
    {
      "t0": 21.72,
      "t1": 23.88,
      "texto": "O sentido lhes ficava escondido,"
    },
    {
      "t0": 24.06,
