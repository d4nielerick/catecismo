{
  "referencia": "Lc 12,13-21",
  "voz": "Algenib (gemini-3.8-flash-tts)",
  "duracao": 90.08,
  "linhas": [
    {
      "t0": 0,
      "t1": 3.58,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 4.84,
      "t1": 6.24,
      "texto": "Naquele tempo,"
    },
    {
      "t0": 6.24,
      "t1": 8.82,
      "texto": "alguém, do meio da multidão, disse a Jesus:"
    },
    {
      "t0": 9.28,
      "t1": 13.18,
      "texto": "\"Mestre, dize ao meu irmão que reparta a herança comigo\"."
    },
    {
      "t0": 14.1,
      "t1": 15.44,
      "texto": "Jesus respondeu:"
    },
    {
      "t0": 16.46,
      "t1": 18.94,
      "texto": "\"Homem, quem me encarregou de julgar"
    },
    {
      "t0": 18.94,
      "t1": 20.72,
      "texto": "ou de dividir vossos bens?\""
    },
    {
      "t0": 21.35,
      "t1": 23.2,
      "texto": "E disse-lhes:"
    },
    {
      "t0": 23.2,
      "t1": 23.66,
      "texto": "\"Atenção!"
    },
    {
      "t0": 24.48,
      "t1": 26.92,
      "texto": "Tomai cuidado contra todo tipo de ganância,"
    },
    {
      "t0": 26.92,
      "t1": 29.82,
      "texto": "porque, mesmo que alguém tenha muitas coisas,"
    },
    {
      "t0": 30.32,
      "t1": 31.38,
      "texto": "a vida de um homem"
    },
    {
      "t0": 31.38,
      "t1": 33.82,
      "texto": "não consiste na abundância de bens\"."
    },
    {
      "t0": 34.22,
      "t1": 36.04,
      "texto": "E contou-lhes uma parábola:"
    },
    {
      "t0": 36.74,
      "t1": 38.22,
      "texto": "\"A terra de um homem rico"
    },
    {
      "t0": 38.22,
      "t1": 39.9,
      "texto": "deu uma grande colheita."
    },
    {
      "t0": 40.56,
      "t1": 42.16,
      "texto": "Ele pensava consigo mesmo:"
    },
    {
      "t0": 42.88,
      "t1": 43.84,
      "texto": "'O que vou fazer?"
    },
    {
      "t0": 44.4,
      "t1": 46.66,
      "texto": "Não tenho onde guardar minha colheita'."
    },
    {
      "t0": 47.14,
      "t1": 48.38,
      "texto": "Então resolveu:"
    },
    {
      "t0": 49.26,
      "t1": 50.3,
      "texto": "'Já sei o que fazer!"
    },
    {
      "t0": 50.74,
      "t1": 53.94,
      "texto": "Vou derrubar meus celeiros e construir maiores;"
    },
    {
      "t0": 53.94,
      "t1": 57.02,
      "texto": "neles vou guardar todo o meu trigo,"
    },
    {
      "t0": 57.22,
      "t1": 58.58,
      "texto": "junto com os meus bens."
    },
    {
      "t0": 59.12,
      "t1": 61.08,
      "texto": "Então poderei dizer a mim mesmo:"
    },
    {
      "t0": 61.78,
      "t1": 62.54,
      "texto": "Meu caro,"
    },
    {
      "t0": 63.28,
      "t1": 65.76,
      "texto": "tu tens uma boa reserva para muitos anos."
    },
    {
      "t0": 66.48,
      "t1": 70.68,
      "texto": "Descansa, come, bebe, aproveita!'"
    },
    {
      "t0": 71.4,
      "t1": 72.88,
      "texto": "Mas Deus lhe disse:"
    },
    {
      "t0": 73.6,
      "t1": 74.04,
      "texto": "'Louco!"
    },
    {
      "t0": 75.16,
      "t1": 78.22,
      "texto": "Ainda nesta noite, pedirão de volta a tua vida."
    },
    {
      "t0": 78.68,
      "t1": 80.92,
      "texto": "E para quem ficará o que tu acumulaste?'"
    },
    {
      "t0": 80.92,
      "t1": 82.86,
      "texto": "Assim acontece"
    },
    {
      "t0": 83.2,
      "t1": 85.64,
      "texto": "com quem ajunta tesouros para si mesmo,"
    },
    {
      "t0": 86.02,
      "t1": 87.74,
      "texto": "mas não é rico diante de Deus\"."
    },
    {
      "t0": 88.74,
      "t1": 90.08,
      "texto": "Palavra da Salvação."
    }
  ]
}
