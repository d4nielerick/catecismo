    {
      "t0": 0,
      "t1": 18.24,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 18.92,
      "t1": 22.06,
      "texto": "Naquele tempo, disse Jesus aos seus discípulos:"
    },
    {
      "t0": 22.28,
      "t1": 25.06,
      "texto": "\"Que vossos rins estejam cingidos"
    },
    {
      "t0": 25.06,
      "t1": 26.64,
      "texto": "e as lâmpadas acesas."
    },
    {
      "t0": 27.35,
      "t1": 29.38,
      "texto": "Sede como homens que estão esperando"
    },
    {
      "t0": 29.38,
      "t1": 32.02,
      "texto": "seu senhor voltar de uma festa de casamento,"
    },
    {
      "t0": 32.28,
      "t1": 34.9,
      "texto": "para lhe abrirem, imediatamente, a porta,"
    },
    {
      "t0": 35.12,
      "t1": 36.94,
      "texto": "logo que ele chegar e bater."
    },
    {
      "t0": 37.8,
      "t1": 40.1,
      "texto": "Felizes os empregados que o senhor"
    },
    {
      "t0": 40.1,
      "t1": 42.04,
      "texto": "encontrar acordados quando chegar."
    },
    {
      "t0": 42.42,
      "t1": 44.34,
      "texto": "Em verdade eu vos digo:"
    },
    {
      "t0": 44.82,
      "t1": 47.94,
      "texto": "Ele mesmo vai cingir-se,"
    },
    {
      "t0": 47.94,
      "t1": 48.34,
      "texto": "fazê-los sentar-se à mesa"
    },
    {
      "t0": 48.54,
      "t1": 50.38,
      "texto": "e, passando, os servirá."
    },
    {
      "t0": 50.38,
      "t1": 53.18,
      "texto": "E caso ele chegue à meia-noite"
    },
    {
      "t0": 53.18,
      "t1": 54.76,
      "texto": "ou às três da madrugada,"
    },
    {
      "t0": 55.38,
      "t1": 57.6,
      "texto": "felizes serão, se assim os encontrar!\""
    },
    {
      "t0": 58.14,
      "t1": 59.58,
      "texto": "Palavra da Salvação."
    }
  ]
