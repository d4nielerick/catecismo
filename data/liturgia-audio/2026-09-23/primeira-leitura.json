  "linhas": [
    {
      "t0": 0,
      "t1": 1.67,
      "texto": "Leitura do Livro dos Provérbios."
    },
    {
      "t0": 1.95,
      "t1": 3.73,
      "texto": "A Palavra de Deus é comprovada."
    },
    {
      "t0": 4,
      "t1": 6.5,
      "texto": "Ele é um escudo para os que nele se abrigam."
    },
    {
      "t0": 6.83,
      "t1": 9.22,
      "texto": "Não acrescentes nada às suas palavras,"
    },
    {
      "t0": 9.39,
      "t1": 11.08,
      "texto": "para que ele não te repreenda"
    },
    {
      "t0": 11.12,
      "t1": 12.77,
      "texto": "e passes por mentiroso!"
    },
    {
      "t0": 13.21,
      "t1": 14.78,
      "texto": "Duas coisas eu te pedi;"
    },
    {
      "t0": 15.16,
      "t1": 17.52,
      "texto": "não mas recuses, antes de eu morrer:"
    },
    {
      "t0": 17.8,
      "t1": 20.32,
      "texto": "afasta de mim a falsidade e a mentira,"
    },
    {
      "t0": 20.56,
      "t1": 22.52,
      "texto": "não me dês pobreza nem riqueza,"
    },
    {
      "t0": 22.7,
      "t1": 25.21,
      "texto": "mas concede-me o pão que me é necessário."
    },
    {
      "t0": 25.81,
      "t1": 28.89,
      "texto": "Não aconteça que, saciado, eu te renegue"
    },
    {
      "t0": 28.96,
      "t1": 30.99,
      "texto": "e diga: \"Quem é o Senhor?\""
    },
    {
      "t0": 31.37,
      "t1": 34.4,
      "texto": "Ou que, empobrecido, eu me ponha a roubar"
    },
    {
      "t0": 34.45,
      "t1": 36.03,
      "texto": "e profane o nome de meu Deus."
    },
    {
      "t0": 36.35,
      "t1": 37.71,
      "texto": "Palavra do Senhor."
    }
  ]
}
