{
  "referencia": "Lc 9,57-62",
  "voz": "Brian (ElevenLabs, multilíngue v2)",
  "duracao": 52.2,
  "linhas": [
    {
      "t0": 0,
      "t1": 3.56,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 3.95,
      "t1": 4.85,
      "texto": "Naquele tempo,"
    },
    {
      "t0": 5.03,
      "t1": 7.84,
      "texto": "enquanto Jesus e seus discípulos caminhavam,"
    },
    {
      "t0": 8.08,
      "t1": 10,
      "texto": "alguém na estrada disse a Jesus:"
    },
    {
      "t0": 10.24,
      "t1": 12.79,
      "texto": "\"Eu te seguirei para onde quer que fores\"."
    },
    {
      "t0": 13.23,
      "t1": 14.61,
      "texto": "Jesus lhe respondeu:"
    },
    {
      "t0": 14.85,
      "t1": 16.35,
      "texto": "\"As raposas têm tocas"
    },
    {
      "t0": 16.38,
      "t1": 17.76,
      "texto": "e os pássaros têm ninhos;"
    },
    {
      "t0": 18.09,
      "t1": 19.12,
      "texto": "mas o Filho do Homem"
    },
    {
      "t0": 19.3,
      "t1": 21.34,
      "texto": "não tem onde repousar a cabeça\"."
    },
    {
      "t0": 21.78,
      "t1": 22.99,
      "texto": "Jesus disse a outro:"
    },
    {
      "t0": 23.14,
      "t1": 24.1,
      "texto": "\"Segue-me\"."
    },
    {
      "t0": 24.54,
      "t1": 25.62,
      "texto": "Este respondeu:"
    },
    {
      "t0": 25.83,
      "t1": 28.43,
      "texto": "\"Deixa-me primeiro ir enterrar meu pai\"."
    },
    {
      "t0": 28.82,
      "t1": 29.94,
      "texto": "Jesus respondeu:"
    },
    {
      "t0": 30.15,
      "t1": 32.86,
      "texto": "\"Deixa que os mortos enterrem os seus mortos;"
    },
    {
      "t0": 33.1,
      "t1": 35.7,
      "texto": "mas tu, vai anunciar o Reino de Deus\"."
    },
    {
      "t0": 36.14,
      "t1": 37.74,
      "texto": "Um outro ainda lhe disse:"
    },
    {
      "t0": 37.92,
      "t1": 39.58,
      "texto": "\"Eu te seguirei, Senhor,"
    },
    {
      "t0": 39.75,
      "t1": 40.98,
      "texto": "mas deixa-me primeiro"
    },
    {
      "t0": 41.04,
      "t1": 42.96,
      "texto": "despedir-me dos meus familiares\"."
    },
    {
      "t0": 43.47,
      "t1": 45.29,
      "texto": "Jesus, porém, respondeu-lhe:"
    },
    {
      "t0": 45.62,
      "t1": 48.41,
      "texto": "\"Quem põe a mão no arado e olha para trás,"
    },
    {
      "t0": 48.56,
      "t1": 50.45,
      "texto": "não está apto para o Reino de Deus\"."
    },
    {
      "t0": 50.77,
      "t1": 52.2,
      "texto": "Palavra da Salvação."
    }
  ]
}
