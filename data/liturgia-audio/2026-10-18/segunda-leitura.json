  "duracao": 57.22,
  "linhas": [
    {
      "t0": 0,
      "t1": 4.32,
      "texto": "Leitura da Primeira Carta de São Paulo aos Tessalonicenses."
    },
    {
      "t0": 5.48,
      "t1": 8.16,
      "texto": "Paulo, Silvano e Timóteo,"
    },
    {
      "t0": 8.3,
      "t1": 10.44,
      "texto": "à Igreja dos tessalonicenses,"
    },
    {
      "t0": 10.68,
      "t1": 14.34,
      "texto": "reunida em Deus Pai e no Senhor Jesus Cristo:"
    },
    {
      "t0": 14.96,
      "t1": 17.62,
      "texto": "a vós, graça e paz!"
    },
    {
      "t0": 18.42,
      "t1": 21.12,
      "texto": "Damos graças a Deus por todos vós,"
    },
    {
      "t0": 21.12,
      "t1": 24,
      "texto": "lembrando-vos sempre em nossas orações."
    },
    {
      "t0": 25.32,
      "t1": 27.14,
      "texto": "Diante de Deus, nosso Pai,"
    },
    {
      "t0": 27.82,
      "t1": 31.04,
      "texto": "recordamos sem cessar a atuação da vossa fé,"
    },
    {
      "t0": 31.34,
      "t1": 34.76,
      "texto": "o esforço da vossa caridade e a firmeza"
    },
    {
      "t0": 34.76,
      "t1": 37.94,
      "texto": "da vossa esperança em nosso Senhor Jesus Cristo."
    },
    {
      "t0": 39.1,
      "t1": 41.48,
      "texto": "Sabemos, irmãos amados por Deus,"
    },
    {
      "t0": 41.7,
      "t1": 44.06,
      "texto": "que sois do número dos escolhidos."
    },
    {
      "t0": 44.42,
      "t1": 47.56,
      "texto": "Porque o nosso evangelho não chegou até vós"
    },
    {
      "t0": 47.56,
      "t1": 49.12,
      "texto": "somente por meio de palavras,"
    },
    {
      "t0": 49.12,
      "t1": 52.82,
      "texto": "mas também mediante a força que é o Espírito Santo;"
    },
    {
      "t0": 53.18,
      "t1": 55.38,
      "texto": "e isso, com toda a abundância."
    },
    {
      "t0": 56.12,
      "t1": 57.22,
      "texto": "Palavra do Senhor."
    }
  ]
}
