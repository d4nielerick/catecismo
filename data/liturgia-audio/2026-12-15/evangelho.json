    {
      "t0": 0,
      "t1": 3.32,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Mateus."
    },
    {
      "t0": 3.32,
      "t1": 5.52,
      "texto": "Naquele tempo, disse Jesus"
    },
    {
      "t0": 5.52,
      "t1": 8.22,
      "texto": "aos chefes dos sacerdotes e anciãos do povo:"
    },
    {
      "t0": 8.42,
      "t1": 9.62,
      "texto": "\"Que vos parece?"
    },
    {
      "t0": 9.9,
      "t1": 11.66,
      "texto": "Um homem tinha dois filhos."
    },
    {
      "t0": 11.66,
      "t1": 13.84,
      "texto": "Dirigindo-se ao primeiro, ele disse:"
    },
    {
      "t0": 14.12,
      "t1": 16.46,
      "texto": "'Filho, vai trabalhar hoje na vinha!'"
    },
    {
      "t0": 16.66,
      "t1": 18.56,
      "texto": "O filho respondeu: 'Não quero'."
    },
    {
      "t0": 18.8,
      "t1": 20.82,
      "texto": "Mas depois mudou de opinião e foi."
    },
    {
      "t0": 21.08,
      "t1": 22.96,
      "texto": "O pai dirigiu-se ao outro filho"
    },
    {
      "t0": 22.96,
      "t1": 24.14,
      "texto": "e disse a mesma coisa."
    },
    {
      "t0": 24.64,
      "t1": 27.04,
      "texto": "Este respondeu: `Sim, senhor, eu vou'."
    },
    {
      "t0": 27.2,
      "t1": 28.08,
      "texto": "Mas não foi."
    },
    {
      "t0": 28.08,
      "t1": 30.28,
      "texto": "Qual dos dois fez a vontade do pai?'"
    },
    {
      "t0": 30.5,
      "t1": 33.74,
      "texto": "Os sumos sacerdotes e os anciãos do povo responderam:"
    },
    {
      "t0": 33.9,
      "t1": 34.58,
      "texto": "\"O primeiro\"."
    },
    {
      "t0": 34.94,
      "t1": 36.32,
      "texto": "Então Jesus lhes disse:"
    },
    {
      "t0": 36.6,
      "t1": 37.88,
      "texto": "\"Em verdade vos digo,"
    },
    {
      "t0": 38.06,
      "t1": 39.96,
      "texto": "que os publicanos e as prostitutas"
    },
    {
      "t0": 39.96,
      "t1": 41.64,
      "texto": "vos precedem no Reino de Deus."
    },
    {
      "t0": 41.88,
      "t1": 44.82,
      "texto": "Porque João veio até vós, num caminho de justiça,"
    },
    {
      "t0": 44.98,
      "t1": 46.88,
      "texto": "e vós não acreditastes nele."
    },
    {
      "t0": 47.18,
      "t1": 50.52,
      "texto": "Ao contrário, os publicanos e as prostitutas creram nele."
    },
    {
      "t0": 50.88,
      "t1": 52.9,
      "texto": "Vós, porém, mesmo vendo isso,"
    },
    {
      "t0": 53.2,
