      "texto": "Leitura da Profecia de Sofonias."
    },
    {
      "t0": 2.18,
      "t1": 3.76,
      "texto": "Assim fala o Senhor:"
    },
    {
      "t0": 4.42,
      "t1": 6.3,
      "texto": "\"Ai de ti, rebelde e desonrada,"
    },
    {
      "t0": 6.62,
      "t1": 7.74,
      "texto": "cidade desumana."
    },
    {
      "t0": 7.92,
      "t1": 10,
      "texto": "Ela não prestou ouvidos ao apelo,"
    },
    {
      "t0": 10.24,
      "t1": 11.62,
      "texto": "não aceitou a correção;"
    },
    {
      "t0": 12,
      "t1": 13.54,
      "texto": "não teve confiança no Senhor,"
    },
    {
      "t0": 13.82,
      "t1": 15.42,
      "texto": "nem se aproximou de seu Deus."
    },
    {
      "t0": 15.9,
      "t1": 17.52,
      "texto": "Darei aos povos, nesse tempo,"
    },
    {
      "t0": 17.82,
      "t1": 19.12,
      "texto": "lábios purificados,"
    },
    {
      "t0": 19.36,
      "t1": 21.54,
      "texto": "para que todos invoquem o nome do Senhor"
    },
    {
      "t0": 21.54,
      "t1": 24.08,
      "texto": "e lhe prestem culto em união de esforços."
    },
    {
      "t0": 24.34,
      "t1": 26.3,
      "texto": "Desde além-rios da Etiópia,"
    },
    {
      "t0": 26.52,
      "t1": 27.42,
      "texto": "os que me adoram,"
    },
    {
      "t0": 27.64,
      "t1": 29.12,
      "texto": "os dispersos do meu povo,"
    },
    {
      "t0": 29.12,
      "t1": 30.74,
      "texto": "me trarão suas oferendas."
    },
    {
      "t0": 31.12,
      "t1": 33.44,
      "texto": "Naquele dia, não terás de envergonhar-te"
    },
    {
      "t0": 33.44,
      "t1": 35.18,
      "texto": "por causa de todas as tuas obras"
    },
    {
      "t0": 35.18,
      "t1": 36.86,
      "texto": "com que prevaricaste contra mim;"
    },
    {
      "t0": 37.22,
      "t1": 38.76,
      "texto": "pois eu afastarei do teu meio"
    },
    {
      "t0": 38.76,
      "t1": 40.3,
      "texto": "teus fanfarrões arrogantes,"
    },
    {
      "t0": 40.46,
      "t1": 43.1,
      "texto": "e não continuarás a fazer de meu santo monte"
    },
    {
      "t0": 43.1,
      "t1": 44.7,
      "texto": "motivo de tuas vanglórias."
    },
    {
      "t0": 44.84,
      "t1": 46.3,
      "texto": "E deixarei entre vós"
    },
    {
      "t0": 46.3,
      "t1": 48.4,
      "texto": "um punhado de homens humildes e pobres\"."
    },
    {
      "t0": 48.62,
      "t1": 50.84,
      "texto": "E no nome do Senhor porá sua esperança"
    },
    {
      "t0": 50.84,
      "t1": 51.86,
      "texto": "o resto de Israel."
    },
    {
      "t0": 52.18,
      "t1": 53.94,
      "texto": "Eles não cometerão iniquidades"
    },
    {
      "t0": 53.94,
      "t1": 55.2,
      "texto": "nem falarão mentiras;"
    },
    {
      "t0": 55.38,
      "t1": 57.06,
      "texto": "não se encontrará em sua boca"
    },
    {
      "t0": 57.06,
      "t1": 58.16,
      "texto": "uma língua enganadora;"
    },
    {
      "t0": 58.16,
