{
  "referencia": "Lc 12,39-48",
  "voz": "Daniel (ElevenLabs, v4)",
  "duracao": 101.28,
  "linhas": [
    {
      "t0": 0,
      "t1": 4.08,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 4.56,
      "t1": 5.76,
      "texto": "Naquele tempo,"
    },
    {
      "t0": 5.84,
      "t1": 7.92,
      "texto": "disse Jesus aos seus discípulos:"
    },
    {
      "t0": 8.56,
      "t1": 11.04,
      "texto": "\"Ficai certos: se o dono da casa"
    },
    {
      "t0": 11.12,
      "t1": 13.84,
      "texto": "soubesse a hora em que o ladrão iria chegar,"
    },
    {
      "t0": 13.92,
      "t1": 16.44,
      "texto": "não deixaria que arrombasse a sua casa."
    },
    {
      "t0": 16.8,
      "t1": 18.72,
      "texto": "Vós também ficai preparados!"
    },
    {
      "t0": 19.2,
      "t1": 20.72,
      "texto": "Porque o Filho do Homem vai chegar"
    },
    {
      "t0": 20.8,
      "t1": 23.12,
      "texto": "na hora em que menos o esperardes\"."
    },
    {
      "t0": 24,
      "t1": 25.32,
      "texto": "Então Pedro disse:"
    },
    {
      "t0": 25.6,
      "t1": 27.68,
      "texto": "\"Senhor, tu contas esta parábola"
    },
    {
      "t0": 27.76,
      "t1": 29.44,
      "texto": "para nós ou para todos?\""
    },
    {
      "t0": 30,
      "t1": 31.44,
      "texto": "E o Senhor respondeu:"
    },
    {
      "t0": 31.84,
      "t1": 34.32,
      "texto": "\"Quem é o administrador fiel e prudente"
    },
    {
      "t0": 34.64,
      "t1": 35.68,
      "texto": "que o senhor vai colocar"
    },
    {
      "t0": 35.76,
      "t1": 37.52,
      "texto": "à frente do pessoal de sua casa"
    },
    {
      "t0": 37.84,
      "t1": 40.44,
      "texto": "para dar comida a todos na hora certa?"
    },
    {
      "t0": 40.8,
      "t1": 43.6,
      "texto": "Feliz o empregado que o patrão, ao chegar,"
    },
    {
      "t0": 43.72,
      "t1": 45.6,
      "texto": "encontrar agindo assim!"
    },
    {
      "t0": 45.68,
      "t1": 47.36,
      "texto": "Em verdade eu vos digo:"
    },
    {
      "t0": 47.41,
      "t1": 48.96,
      "texto": "o senhor lhe confiará"
    },
    {
      "t0": 49.04,
      "t1": 51.92,
      "texto": "a administração de todos os seus bens."
    },
    {
      "t0": 52.04,
      "t1": 54.48,
      "texto": "Porém, se aquele empregado pensar:"
    },
    {
      "t0": 54.53,
      "t1": 56.24,
      "texto": "'Meu patrão está demorando',"
    },
    {
      "t0": 56.28,
      "t1": 59.28,
      "texto": "e começar a espancar os criados e as criadas,"
    },
    {
      "t0": 59.32,
      "t1": 62.48,
      "texto": "e a comer, a beber e a embriagar-se,"
    },
    {
      "t0": 62.52,
      "t1": 63.84,
      "texto": "o senhor daquele empregado"
    },
    {
      "t0": 63.92,
      "t1": 65.6,
      "texto": "chegará num dia inesperado"
    },
    {
      "t0": 65.92,
      "t1": 67.84,
      "texto": "e numa hora imprevista,"
    },
    {
      "t0": 67.96,
      "t1": 69.28,
      "texto": "ele o partirá ao meio"
    },
    {
      "t0": 69.52,
      "t1": 72.6,
      "texto": "e o fará participar do destino dos infiéis."
    },
    {
      "t0": 72.96,
      "t1": 74.32,
      "texto": "Aquele empregado que,"
    },
    {
      "t0": 74.4,
      "t1": 76.4,
      "texto": "conhecendo a vontade do senhor,"
    },
    {
      "t0": 76.48,
      "t1": 80.08,
      "texto": "nada preparou, nem agiu conforme a sua vontade,"
    },
    {
      "t0": 80.2,
      "t1": 82.24,
      "texto": "será chicoteado muitas vezes"
    },
    {
      "t0": 82.8,
      "t1": 86,
      "texto": "Porém, o empregado que não conhecia essa vontade"
    },
    {
      "t0": 86.32,
      "t1": 88.64,
      "texto": "e fez coisas que merecem castigo,"
    },
    {
      "t0": 88.72,
      "t1": 90.88,
      "texto": "será chicoteado poucas vezes."
    },
    {
      "t0": 91.44,
      "t1": 94.96,
      "texto": "A quem muito foi dado, muito será pedido;"
    },
    {
      "t0": 95,
      "t1": 99.04,
      "texto": "a quem muito foi confiado, muito mais será exigido!"
    },
    {
      "t0": 99.6,
      "t1": 101.28,
      "texto": "Palavra da Salvação."
    }
  ]
}
