{
  "referencia": "Gl 5,18-25",
  "voz": "Algenib (gemini-3.8-flash-tts)",
  "duracao": 100.98,
  "linhas": [
    {
      "t0": 0,
      "t1": 22.7,
      "texto": "Leitura da Carta de São Paulo aos Gálatas."
    },
    {
      "t0": 24.64,
      "t1": 25.32,
      "texto": "Irmãos,"
    },
    {
      "t0": 25.32,
      "t1": 27.82,
      "texto": "se sois conduzidos pelo Espírito,"
    },
    {
      "t0": 27.82,
      "t1": 30.38,
      "texto": "então não estais sob o jugo da Lei."
    },
    {
      "t0": 31.36,
      "t1": 33.82,
      "texto": "São bem conhecidas as obras da carne:"
    },
    {
      "t0": 34.26,
      "t1": 37.92,
      "texto": "fornicação, libertinagem, devassidão,"
    },
    {
      "t0": 38.62,
      "t1": 42.08,
      "texto": "idolatria, feitiçaria, inimizades,"
    },
    {
      "t0": 42.82,
      "t1": 45.94,
      "texto": "contendas, ciúmes, iras,"
    },
    {
      "t0": 46.54,
      "t1": 49.74,
      "texto": "intrigas, discórdias, facções,"
    },
    {
      "t0": 50.6,
      "t1": 53.62,
      "texto": "invejas, bebedeiras, orgias,"
    },
    {
      "t0": 53.62,
      "t1": 55.84,
      "texto": "e coisas semelhantes a estas."
    },
    {
      "t0": 55.84,
      "t1": 59.6,
      "texto": "Eu vos previno, como aliás já o fiz:"
    },
    {
      "t0": 60.08,
      "t1": 61.98,
      "texto": "os que praticam essas coisas"
    },
    {
      "t0": 61.98,
      "t1": 63.94,
      "texto": "não herdarão o reino de Deus."
    },
    {
      "t0": 64.5,
      "t1": 67.08,
      "texto": "Porém, o fruto do Espírito é:"
    },
    {
      "t0": 67.08,
      "t1": 70.78,
      "texto": "caridade, alegria, paz,"
    },
    {
      "t0": 71.58,
      "t1": 74.14,
      "texto": "longanimidade, benignidade,"
    },
    {
      "t0": 75.06,
      "t1": 77.36,
      "texto": "bondade, lealdade,"
    },
    {
      "t0": 78.28,
      "t1": 80.44,
      "texto": "mansidão, continência."
    },
    {
      "t0": 81.52,
      "t1": 84.08,
      "texto": "Contra estas coisas não existe lei."
    },
    {
      "t0": 84.08,
      "t1": 87.26,
      "texto": "Os que pertencem a Jesus Cristo"
    },
    {
      "t0": 87.26,
      "t1": 88.92,
      "texto": "crucificaram a carne"
    },
    {
      "t0": 89.14,
      "t1": 92.04,
      "texto": "com suas paixões e seus maus desejos."
    },
    {
      "t0": 92.56,
      "t1": 94.7,
      "texto": "Se vivemos pelo Espírito,"
    },
    {
      "t0": 95.46,
      "t1": 97.62,
      "texto": "procedamos também segundo o Espírito,"
    },
    {
      "t0": 97.94,
      "t1": 98.9,
      "texto": "corretamente."
    },
    {
      "t0": 99.6,
      "t1": 100.98,
      "texto": "Palavra do Senhor."
    }
  ]
}
