    },
    {
      "t0": 18.96,
      "t1": 21.06,
      "texto": "Só isto quero saber de vós:"
    },
    {
      "t0": 22.4,
      "t1": 25.08,
      "texto": "Recebestes o Espírito pela prática da Lei"
    },
    {
      "t0": 25.66,
      "t1": 27.8,
      "texto": "ou pela fé através da pregação?"
    },
    {
      "t0": 29.02,
      "t1": 30.9,
      "texto": "Sois assim tão insensatos?"
    },
    {
      "t0": 31.9,
      "t1": 32.72,
      "texto": "A ponto de,"
    },
    {
      "t0": 33.06,
      "t1": 35.36,
      "texto": "depois de terdes começado pelo espírito,"
    },
    {
      "t0": 35.36,
      "t1": 37.68,
      "texto": "quererdes terminar pela carne?"
    },
    {
      "t0": 37.68,
      "t1": 40.8,
      "texto": "Foi acaso em vão que sofrestes tanto?"
    },
    {
      "t0": 41.46,
      "t1": 43.34,
      "texto": "Se é que foi mesmo em vão!"
    },
    {
      "t0": 43.98,
      "t1": 46.96,
      "texto": "Aquele que vos dá generosamente o Espírito"
    },
    {
      "t0": 47.1,
