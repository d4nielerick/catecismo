  "linhas": [
    {
      "t0": 0,
      "t1": 3.76,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 5.14,
      "t1": 8.2,
      "texto": "Naquele tempo, disse Jesus aos seus discípulos:"
    },
    {
      "t0": 9.38,
      "t1": 11.46,
      "texto": "\"Se um de vós tiver um amigo"
    },
    {
      "t0": 11.46,
      "t1": 13.38,
      "texto": "e for procurá-lo à meia-noite"
    },
    {
      "t0": 13.38,
      "t1": 14.28,
      "texto": "e lhe disser:"
    },
    {
      "t0": 14.58,
      "t1": 17.04,
      "texto": "'Amigo, empresta-me três pães,"
    },
    {
      "t0": 17.2,
      "t1": 19.46,
      "texto": "porque um amigo meu chegou de viagem"
    },
    {
      "t0": 19.46,
      "t1": 21.4,
      "texto": "e nada tenho para lhe oferecer',"
    },
    {
      "t0": 22.1,
      "t1": 24.46,
      "texto": "e se o outro responder lá de dentro:"
    },
    {
      "t0": 25.02,
      "t1": 26.06,
      "texto": "'Não me incomodes!"
    },
    {
      "t0": 26.56,
      "t1": 27.66,
      "texto": "Já tranquei a porta,"
    },
    {
      "t0": 27.66,
      "t1": 29.92,
      "texto": "e meus filhos e eu já estamos deitados;"
    },
    {
      "t0": 30.52,
      "t1": 32.8,
      "texto": "não me posso levantar para te dar os pães';"
    },
    {
      "t0": 33.12,
      "t1": 34.46,
      "texto": "eu vos declaro:"
    },
    {
      "t0": 34.94,
      "t1": 37.26,
      "texto": "mesmo que o outro não se levante"
    },
    {
      "t0": 37.26,
      "t1": 38.94,
      "texto": "para dá-los porque é seu amigo,"
    },
    {
      "t0": 39.44,
      "t1": 40.54,
      "texto": "vai levantar-se"
    },
    {
      "t0": 40.54,
      "t1": 42.92,
      "texto": "ao menos por causa da impertinência dele"
    },
    {
      "t0": 43.3,
      "t1": 45.28,
      "texto": "e lhe dará quanto for necessário."
    },
    {
      "t0": 46.32,
      "t1": 47.86,
      "texto": "Portanto, eu vos digo:"
    },
    {
      "t0": 48.68,
      "t1": 50.1,
      "texto": "pedi e recebereis;"
    },
    {
      "t0": 50.78,
      "t1": 52.7,
      "texto": "procurai e encontrareis;"
    },
    {
      "t0": 53.54,
      "t1": 55.32,
      "texto": "batei e vos será aberto."
    },
    {
      "t0": 55.88,
      "t1": 57.92,
      "texto": "Pois quem pede, recebe;"
    },
    {
      "t0": 57.92,
      "t1": 60.22,
      "texto": "quem procura, encontra;"
    },
    {
      "t0": 60.46,
      "t1": 62.78,
      "texto": "e, para quem bate, se abrirá."
    },
    {
      "t0": 63.42,
      "t1": 65.86,
      "texto": "Será que algum de vós que é pai,"
    },
    {
      "t0": 66.3,
      "t1": 67.74,
      "texto": "se o filho pedir um peixe,"
    },
    {
      "t0": 68.14,
      "t1": 68.98,
      "texto": "lhe dará uma cobra?"
    },
    {
      "t0": 69.4,
      "t1": 71.9,
      "texto": "Ou ainda, se pedir um ovo,"
    },
    {
      "t0": 72.22,
      "t1": 73.64,
      "texto": "lhe dará um escorpião?"
    },
    {
      "t0": 74.2,
      "t1": 76.62,
      "texto": "Ora, se vós que sois maus,"
    },
    {
      "t0": 77,
      "t1": 79.3,
      "texto": "sabeis dar coisas boas aos vossos filhos,"
    },
    {
      "t0": 79.3,
      "t1": 83.08,
      "texto": "quanto mais o Pai do Céu dará o Espírito Santo"
    },
    {
      "t0": 83.08,
      "t1": 84.62,
      "texto": "aos que o pedirem!\""
    },
    {
      "t0": 84.62,
      "t1": 86.36,
      "texto": "Palavra da Salvação."
    }
  ]
}
