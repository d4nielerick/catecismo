    {
      "t0": 0,
      "t1": 4.28,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Mateus."
    },
    {
      "t0": 5.56,
      "t1": 6.72,
      "texto": "Naquele tempo,"
    },
    {
      "t0": 6.94,
      "t1": 9.38,
      "texto": "Os fariseus ouviram dizer que Jesus"
    },
    {
      "t0": 9.38,
      "t1": 11.48,
      "texto": "tinha feito calar os saduceus."
    },
    {
      "t0": 11.68,
      "t1": 14.18,
      "texto": "Então eles se reuniram em grupo,"
    },
    {
      "t0": 14.24,
      "t1": 18.7,
      "texto": "e um deles perguntou a Jesus, para experimentá-lo:"
    },
    {
      "t0": 18.7,
      "t1": 21.9,
      "texto": "\"Mestre, qual é o maior mandamento da Lei?\""
    },
    {
      "t0": 22.7,
      "t1": 24.1,
      "texto": "Jesus respondeu:"
    },
    {
      "t0": 25.28,
      "t1": 27.1,
      "texto": "\"'Amarás o Senhor teu Deus"
    },
    {
      "t0": 27.3,
      "t1": 30.72,
      "texto": "de todo o teu coração, de toda a tua alma,"
    },
    {
      "t0": 30.72,
      "t1": 32.86,
      "texto": "e de todo o teu entendimento!'"
    },
    {
      "t0": 33.58,
      "t1": 36.48,
      "texto": "Esse é o maior e o primeiro mandamento."
    },
    {
      "t0": 37.02,
      "t1": 39.16,
      "texto": "O segundo é semelhante a esse:"
    },
    {
      "t0": 40.18,
      "t1": 42.62,
      "texto": "'Amarás ao teu próximo como a ti mesmo'."
    },
    {
      "t0": 43.28,
      "t1": 45.46,
      "texto": "Toda a Lei e os profetas"
    },
    {
      "t0": 45.46,
      "t1": 47.6,
      "texto": "dependem desses dois mandamentos\"."
    },
    {
      "t0": 48.54,
      "t1": 49.88,
      "texto": "Palavra da Salvação."
    }
  ]
