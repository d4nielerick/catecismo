  "linhas": [
    {
      "t0": 0,
      "t1": 2.6,
      "texto": "Leitura do Livro do Apocalipse de São João."
    },
    {
      "t0": 2.6,
      "t1": 4,
      "texto": "Eu, João,"
    },
    {
      "t0": 4.32,
      "t1": 6.12,
      "texto": "vi outro anjo descendo do céu."
    },
    {
      "t0": 6.34,
      "t1": 7.66,
      "texto": "Tinha grande poder,"
    },
    {
      "t0": 7.86,
      "t1": 10.78,
      "texto": "e a terra ficou toda iluminada com a sua glória."
    },
    {
      "t0": 11.04,
      "t1": 13.08,
      "texto": "Ele gritou com voz poderosa:"
    },
    {
      "t0": 13.38,
      "t1": 15.94,
      "texto": "\"Caiu! Caiu Babilônia, a grande!"
    },
    {
      "t0": 15.94,
      "t1": 18.12,
      "texto": "Tornou-se morada de demônios,"
    },
    {
      "t0": 18.48,
      "t1": 20.42,
      "texto": "abrigo de todos os espíritos maus,"
    },
    {
      "t0": 20.74,
      "t1": 23,
      "texto": "abrigo de aves impuras e nojentas."
    },
    {
      "t0": 23.2,
      "t1": 26.54,
      "texto": "Nessa hora, um anjo poderoso levantou uma pedra"
    },
    {
      "t0": 26.54,
      "t1": 28.62,
      "texto": "do tamanho de uma grande pedra de moinho"
    },
    {
      "t0": 28.62,
      "t1": 30.62,
      "texto": "e atirou-a ao mar, dizendo:"
    },
    {
      "t0": 30.84,
      "t1": 33.44,
      "texto": "\"Com esta força será lançada Babilônia,"
    },
    {
      "t0": 33.64,
      "t1": 34.62,
      "texto": "a Grande Cidade,"
    },
    {
      "t0": 34.86,
      "t1": 36.66,
      "texto": "e nunca mais será encontrada."
    },
    {
      "t0": 36.86,
      "t1": 39.12,
      "texto": "E o canto de harpistas e músicos,"
    },
    {
      "t0": 39.3,
      "t1": 41.6,
      "texto": "de flautistas e tocadores de trombeta,"
    },
    {
      "t0": 41.8,
      "t1": 43.62,
      "texto": "em ti nunca mais se ouvirá;"
    },
    {
      "t0": 43.72,
      "t1": 45.68,
      "texto": "e nenhum artista de arte alguma"
    },
    {
      "t0": 45.68,
      "t1": 47.26,
      "texto": "em ti jamais se encontrará;"
    },
    {
      "t0": 47.42,
      "t1": 48.76,
      "texto": "e o canto do moinho"
    },
    {
      "t0": 48.76,
      "t1": 50.58,
      "texto": "em ti nunca mais se ouvirá;"
    },
    {
      "t0": 50.68,
      "t1": 52.04,
      "texto": "e a luz da lâmpada"
    },
    {
      "t0": 52.04,
      "t1": 53.62,
      "texto": "em ti nunca mais brilhará;"
    },
    {
      "t0": 53.76,
      "t1": 55.82,
      "texto": "e a voz do esposo e da esposa"
    },
    {
      "t0": 55.82,
      "t1": 57.4,
      "texto": "em ti nunca mais se ouvirá,"
    },
    {
      "t0": 57.68,
