{
  "referencia": "Lc 9,46-50",
  "voz": "Brian (ElevenLabs, multilíngue v2)",
  "duracao": 47.09,
  "linhas": [
    {
      "t0": 0,
      "t1": 3.54,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 3.92,
      "t1": 4.9,
      "texto": "Naquele tempo,"
    },
    {
      "t0": 4.95,
      "t1": 7.65,
      "texto": "houve entre os discípulos uma discussão,"
    },
    {
      "t0": 7.8,
      "t1": 9.96,
      "texto": "para saber qual deles seria o maior."
    },
    {
      "t0": 10.47,
      "t1": 12.67,
      "texto": "Jesus sabia o que estavam pensando."
    },
    {
      "t0": 12.99,
      "t1": 16.1,
      "texto": "Pegou então uma criança, colocou-a junto de si"
    },
    {
      "t0": 16.22,
      "t1": 17.13,
      "texto": "e disse-lhes:"
    },
    {
      "t0": 17.45,
      "t1": 19.89,
      "texto": "\"Quem receber esta criança em meu nome,"
    },
    {
      "t0": 20.04,
      "t1": 21.42,
      "texto": "estará recebendo a mim."
    },
    {
      "t0": 21.75,
      "t1": 23,
      "texto": "E quem me receber,"
    },
    {
      "t0": 23.21,
      "t1": 25.64,
      "texto": "estará recebendo aquele que me enviou."
    },
    {
      "t0": 26.02,
      "t1": 29.06,
      "texto": "Pois aquele que entre todos vós for o menor,"
    },
    {
      "t0": 29.3,
      "t1": 30.26,
      "texto": "esse é o maior\"."
    },
    {
      "t0": 30.77,
      "t1": 32.08,
      "texto": "João disse a Jesus:"
    },
    {
      "t0": 32.36,
      "t1": 34.03,
      "texto": "\"Mestre, vimos um homem"
    },
    {
      "t0": 34.06,
      "t1": 35.98,
      "texto": "que expulsa demônios em teu nome."
    },
    {
      "t0": 36.3,
      "t1": 37.56,
      "texto": "Mas nós o proibimos,"
    },
    {
      "t0": 37.59,
      "t1": 38.94,
      "texto": "porque não anda conosco\"."
    },
    {
      "t0": 39.38,
      "t1": 40.57,
      "texto": "Jesus disse-lhe:"
    },
    {
      "t0": 40.68,
      "t1": 43.91,
      "texto": "\"Não o proibais, pois quem não está contra vós,"
    },
    {
      "t0": 44.06,
      "t1": 45.29,
      "texto": "está a vosso favor\"."
    },
    {
      "t0": 45.62,
      "t1": 47.09,
      "texto": "Palavra da Salvação."
    }
  ]
}
