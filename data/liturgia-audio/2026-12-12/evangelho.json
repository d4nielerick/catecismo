      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 3.82,
      "t1": 4.9,
      "texto": "Naqueles dias,"
    },
    {
      "t0": 5.14,
      "t1": 7.28,
      "texto": "Maria partiu para a região montanhosa,"
    },
    {
      "t0": 7.28,
