    {
      "t0": 0,
      "t1": 3.5,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 3.94,
      "t1": 5.28,
      "texto": "Aconteceu que Jesus"
    },
    {
      "t0": 5.34,
      "t1": 7.54,
      "texto": "estava rezando num lugar retirado,"
    },
    {
      "t0": 7.78,
