  "linhas": [
    {
      "t0": 0.2,
      "t1": 2.7,
      "texto": "Leitura da Carta de São Paulo aos Efésios."
    },
    {
      "t0": 4.08,
      "t1": 4.68,
      "texto": "Irmãos,"
    },
    {
      "t0": 4.68,
      "t1": 7.78,
      "texto": "já não sois mais estrangeiros nem migrantes,"
    },
    {
      "t0": 7.78,
      "t1": 9.7,
      "texto": "mas concidadãos dos santos."
    },
    {
      "t0": 9.7,
      "t1": 11.8,
      "texto": "Sois da família de Deus."
    },
    {
      "t0": 12.86,
      "t1": 15.04,
      "texto": "Vós fostes integrados no edifício"
    },
    {
      "t0": 15.04,
      "t1": 18.16,
      "texto": "que tem como fundamento os apóstolos e os profetas,"
    },
    {
      "t0": 18.32,
      "t1": 21.6,
      "texto": "e o próprio Jesus Cristo como pedra principal."
    },
    {
      "t0": 22.24,
      "t1": 26.12,
      "texto": "É nele que toda a construção se ajusta e se eleva"
    },
    {
      "t0": 26.12,
      "t1": 28.52,
      "texto": "para formar um templo Santo no Senhor."
    },
    {
      "t0": 29.32,
      "t1": 32.28,
      "texto": "E vós também sois integrados nesta construção,"
    },
    {
      "t0": 32.52,
      "t1": 35.82,
      "texto": "para vos tornardes morada de Deus pelo Espírito."
    },
    {
      "t0": 36.48,
      "t1": 37.58,
      "texto": "Palavra do Senhor."
    }
  ]
}
