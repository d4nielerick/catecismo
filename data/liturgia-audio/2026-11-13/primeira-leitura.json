  "duracao": 76.84,
  "linhas": [
    {
      "t0": 0,
      "t1": 2.64,
      "texto": "Leitura da Segunda Carta de São João."
    },
    {
      "t0": 4.06,
      "t1": 6.1,
      "texto": "Muito me alegrei, Senhora,"
    },
    {
      "t0": 6.36,
      "t1": 8.9,
      "texto": "por ter encontrado alguns dos teus filhos"
    },
    {
      "t0": 9.12,
      "t1": 11.58,
      "texto": "que caminham conforme a verdade,"
    },
    {
      "t0": 12.02,
      "t1": 14.38,
      "texto": "segundo o mandamento que recebemos do Pai."
    },
    {
      "t0": 15.55,
      "t1": 18.02,
      "texto": "E agora, Senhora, eu te peço"
    },
    {
      "t0": 18.02,
      "t1": 20.4,
      "texto": "- não que te esteja escrevendo"
    },
    {
      "t0": 20.4,
      "t1": 22.38,
      "texto": "a respeito de um novo mandamento,"
    },
    {
      "t0": 22.9,
      "t1": 24.42,
      "texto": "pois trata-se daquele"
    },
    {
      "t0": 24.42,
      "t1": 28.28,
      "texto": "que temos desde o princípio - :"
    },
    {
      "t0": 28.28,
      "t1": 29.36,
      "texto": "amemo-nos uns aos outros."
    },
    {
      "t0": 30,
      "t1": 32.54,
      "texto": "E amar consiste no seguinte:"
    },
    {
      "t0": 32.84,
      "t1": 35.38,
      "texto": "em viver conforme os seus mandamentos."
    },
    {
      "t0": 36.6,
      "t1": 39.44,
      "texto": "Este é o mandamento que ouvistes desde o início"
    },
    {
      "t0": 39.72,
      "t1": 41.64,
      "texto": "para guiar o vosso proceder."
    },
    {
      "t0": 42.96,
      "t1": 45.2,
      "texto": "Acontece que se espalharam pelo"
    },
    {
      "t0": 45.2,
      "t1": 46.82,
      "texto": "mundo muitos sedutores,"
    },
    {
      "t0": 47.02,
      "t1": 49.76,
      "texto": "que não confessam a Jesus Cristo encarnado."
    },
    {
      "t0": 50.68,
      "t1": 53.58,
      "texto": "Está aí o Sedutor, o Anticristo."
    },
    {
      "t0": 54.46,
      "t1": 55.72,
      "texto": "Tomai cuidado,"
    },
    {
      "t0": 56.1,
      "t1": 59.04,
      "texto": "se não quereis perder o fruto do vosso trabalho,"
    },
    {
      "t0": 59.04,
      "t1": 62.44,
      "texto": "mas sim, receber a plena recompensa."
    },
    {
      "t0": 63.34,
      "t1": 66.28,
      "texto": "Todo o que não permanece na doutrina de Cristo,"
    },
    {
      "t0": 66.52,
      "t1": 67.66,
      "texto": "mas passa além,"
    },
    {
      "t0": 68.14,
      "t1": 69.34,
      "texto": "não possui a Deus."
    },
    {
      "t0": 70.1,
      "t1": 72.04,
      "texto": "Aquele que permanece na doutrina"
    },
    {
      "t0": 72.04,
      "t1": 74.84,
      "texto": "é o que possui o Pai e o Filho."
    },
    {
      "t0": 75.9,
      "t1": 76.84,
      "texto": "Palavra do Senhor."
    }
  ]
}
