{
  "referencia": "Fl 2,5-11",
  "voz": "Daniel (ElevenLabs, v4)",
  "duracao": 54.4,
  "linhas": [
    {
      "t0": 0,
      "t1": 3.32,
      "texto": "Leitura da Carta de São Paulo aos Filipenses."
    },
    {
      "t0": 3.6,
      "t1": 4.24,
      "texto": "Irmãos,"
    },
    {
      "t0": 4.8,
      "t1": 7.2,
      "texto": "tende entre vós o mesmo sentimento"
    },
    {
      "t0": 7.28,
      "t1": 9.2,
      "texto": "que existe em Cristo Jesus."
    },
    {
      "t0": 9.84,
      "t1": 13.04,
      "texto": "Jesus Cristo, existindo em condição divina,"
    },
    {
      "t0": 13.12,
      "t1": 16.56,
      "texto": "não fez do ser igual a Deus uma usurpação,"
    },
    {
      "t0": 16.64,
      "t1": 19.12,
      "texto": "mas ele esvaziou-se a si mesmo,"
    },
    {
      "t0": 19.24,
      "t1": 20.96,
      "texto": "assumindo a condição de escravo"
    },
    {
      "t0": 21.28,
      "t1": 23.52,
      "texto": "e tornando-se igual aos homens."
    },
    {
      "t0": 24.16,
      "t1": 26.24,
      "texto": "Encontrado com aspecto humano,"
    },
    {
      "t0": 26.32,
      "t1": 27.92,
      "texto": "humilhou-se a si mesmo,"
    },
    {
      "t0": 28,
      "t1": 30.4,
      "texto": "fazendo-se obediente até a morte,"
    },
    {
      "t0": 30.44,
      "t1": 31.68,
      "texto": "e morte de cruz."
    },
    {
      "t0": 32.32,
      "t1": 35.28,
      "texto": "Por isso, Deus o exaltou acima de tudo"
    },
    {
      "t0": 35.6,
      "t1": 38.76,
      "texto": "e lhe deu o Nome que está acima de todo nome."
    },
    {
      "t0": 39.04,
      "t1": 41.36,
      "texto": "Assim, ao nome de Jesus,"
    },
    {
      "t0": 41.52,
      "t1": 43.6,
      "texto": "todo o joelho se dobre no céu,"
    },
    {
      "t0": 43.68,
      "t1": 46.16,
      "texto": "na terra e abaixo da terra,"
    },
    {
      "t0": 46.24,
      "t1": 48.27,
      "texto": "e toda língua proclame :"
    },
    {
      "t0": 48.29,
      "t1": 50.48,
      "texto": "\"Jesus Cristo é o Senhor\""
    },
    {
      "t0": 50.72,
      "t1": 52.68,
      "texto": "- para a glória de Deus Pai."
    },
    {
      "t0": 52.96,
      "t1": 54.4,
      "texto": "Palavra do Senhor."
    }
  ]
}
