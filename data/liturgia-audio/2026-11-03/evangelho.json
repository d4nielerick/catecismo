{
  "referencia": "Lc 14,15-24",
  "voz": "Daniel (ElevenLabs, v4)",
  "duracao": 86.72,
  "linhas": [
    {
      "t0": 0,
      "t1": 3.52,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 4.16,
      "t1": 5.28,
      "texto": "Naquele tempo,"
    },
    {
      "t0": 5.36,
      "t1": 6.96,
      "texto": "um homem que estava à mesa,"
    },
    {
      "t0": 7.04,
      "t1": 8,
      "texto": "disse a Jesus:"
    },
    {
      "t0": 8.56,
      "t1": 11.68,
      "texto": "\"Feliz aquele que come o pão no Reino de Deus!\""
    },
    {
      "t0": 12.32,
      "t1": 13.28,
      "texto": "Jesus respondeu:"
    },
    {
      "t0": 13.92,
      "t1": 15.84,
      "texto": "\"Um homem deu um grande banquete"
    },
    {
      "t0": 16,
      "t1": 18.04,
      "texto": "e convidou muitas pessoas."
    },
    {
      "t0": 18.32,
      "t1": 20.56,
      "texto": "Na hora do banquete, mandou seu empregado"
    },
    {
      "t0": 20.6,
      "t1": 21.76,
      "texto": "dizer aos convidados:"
    },
    {
      "t0": 22.16,
      "t1": 24.4,
      "texto": "'Vinde, pois tudo está pronto'."
    },
    {
      "t0": 24.72,
      "t1": 28.16,
      "texto": "Mas todos, um a um, começaram a dar desculpas."
    },
    {
      "t0": 28.64,
      "t1": 29.52,
      "texto": "O primeiro disse:"
    },
    {
      "t0": 30,
      "t1": 32.24,
      "texto": "'Comprei um campo, e preciso ir vê-lo."
    },
    {
      "t0": 32.64,
      "t1": 34.88,
      "texto": "Peço-te que aceites minhas desculpas'."
    },
    {
      "t0": 35.52,
      "t1": 36.4,
      "texto": "Um outro disse:"
    },
    {
      "t0": 36.8,
      "t1": 38.76,
      "texto": "'Comprei cinco juntas de bois,"
    },
    {
      "t0": 38.88,
      "t1": 40.16,
      "texto": "e vou experimentá-las."
    },
    {
      "t0": 40.56,
      "t1": 42.8,
      "texto": "Peço-te que aceites minhas desculpas'."
    },
    {
      "t0": 43.44,
      "t1": 44.64,
      "texto": "Um terceiro disse:"
    },
    {
      "t0": 44.88,
      "t1": 48.16,
      "texto": "'Acabo de me casar e, por isso, não posso ir'."
    },
    {
      "t0": 48.72,
      "t1": 51.52,
      "texto": "O empregado voltou e contou tudo ao patrão."
    },
    {
      "t0": 52,
      "t1": 54.4,
      "texto": "Então o dono da casa ficou muito zangado"
    },
    {
      "t0": 54.72,
      "t1": 55.92,
      "texto": "e disse ao empregado:"
    },
    {
      "t0": 56.32,
      "t1": 59.12,
      "texto": "'Sai depressa pelas praças e ruas da cidade."
    },
    {
      "t0": 59.52,
      "t1": 61.12,
      "texto": "Traze para cá os pobres,"
    },
    {
      "t0": 61.2,
      "t1": 64,
      "texto": "os aleijados, os cegos e os coxos'."
    },
    {
      "t0": 64.56,
      "t1": 65.52,
      "texto": "O empregado disse:"
    },
    {
      "t0": 65.92,
      "t1": 68.64,
      "texto": "'Senhor, o que tu mandaste fazer foi feito,"
    },
    {
      "t0": 68.88,
      "t1": 70.08,
      "texto": "e ainda há lugar'."
    },
    {
      "t0": 70.64,
      "t1": 72.08,
      "texto": "O patrão disse ao empregado:"
    },
    {
      "t0": 72.56,
      "t1": 74.56,
      "texto": "'Sai pelas estradas e atalhos,"
    },
    {
      "t0": 74.6,
      "t1": 76.48,
      "texto": "e obriga as pessoas a virem aqui,"
    },
    {
      "t0": 76.72,
      "t1": 78.4,
      "texto": "para que minha casa fique cheia'."
    },
    {
      "t0": 78.96,
      "t1": 80.4,
      "texto": "Pois eu vos digo:"
    },
    {
      "t0": 80.48,
      "t1": 82.56,
      "texto": "nenhum daqueles que foram convidados"
    },
    {
      "t0": 82.88,
      "t1": 84.32,
      "texto": "provará do meu banquete'\"."
    },
    {
      "t0": 84.96,
      "t1": 86.72,
      "texto": "Palavra da Salvação."
    }
  ]
}
