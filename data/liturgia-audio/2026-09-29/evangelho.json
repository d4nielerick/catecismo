    },
    {
      "t0": 21.76,
      "t1": 22.45,
      "texto": "eu te vi\"."
    },
    {
      "t0": 22.96,
      "t1": 24.17,
      "texto": "Natanael respondeu:"
    },
    {
      "t0": 24.5,
      "t1": 26.83,
      "texto": "\"Rabi, tu és o Filho de Deus,"
    },
