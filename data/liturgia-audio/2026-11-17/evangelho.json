{
  "referencia": "Lc 19,1-10",
  "voz": "Algenib (gemini-3.8-flash-tts)",
  "duracao": 84.26,
  "linhas": [
    {
      "t0": 0,
      "t1": 3.74,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 5.3,
      "t1": 6.36,
      "texto": "Naquele tempo,"
    },
    {
      "t0": 6.62,
      "t1": 8.5,
      "texto": "Jesus tinha entrado em Jericó"
    },
    {
      "t0": 8.5,
      "t1": 10.52,
      "texto": "e estava atravessando a cidade."
    },
    {
      "t0": 11.28,
      "t1": 13.66,
      "texto": "Havia ali um homem chamado Zaqueu,"
    },
    {
      "t0": 13.88,
      "t1": 17.36,
      "texto": "que era chefe dos cobradores de impostos e muito rico."
    },
    {
      "t0": 18.5,
      "t1": 20.82,
      "texto": "Zaqueu procurava ver quem era Jesus,"
    },
    {
      "t0": 21.32,
      "t1": 23.74,
      "texto": "mas não conseguia, por causa da multidão,"
    },
    {
      "t0": 24.26,
      "t1": 25.36,
      "texto": "pois era muito baixo."
    },
    {
      "t0": 26.34,
      "t1": 28.04,
      "texto": "Então ele correu à frente"
    },
    {
      "t0": 28.04,
      "t1": 30.36,
      "texto": "e subiu numa figueira para ver Jesus,"
    },
    {
      "t0": 30.64,
      "t1": 32.26,
      "texto": "que devia passar por ali."
    },
    {
      "t0": 33.18,
      "t1": 35.14,
      "texto": "Quando Jesus chegou ao lugar,"
    },
    {
      "t0": 35.46,
      "t1": 36.98,
      "texto": "olhou para cima e disse:"
    },
    {
      "t0": 37.72,
      "t1": 40.08,
      "texto": "\"Zaqueu, desce depressa!"
    },
    {
      "t0": 40.38,
      "t1": 42.8,
      "texto": "Hoje eu devo ficar na tua casa\"."
    },
    {
      "t0": 44.08,
      "t1": 45.38,
      "texto": "Ele desceu depressa,"
    },
    {
      "t0": 45.38,
      "t1": 47.72,
      "texto": "e recebeu Jesus com alegria."
    },
    {
      "t0": 48.7,
      "t1": 51.48,
      "texto": "Ao ver isso, todos começaram a murmurar,"
    },
    {
      "t0": 51.7,
      "t1": 52.02,
      "texto": "dizendo:"
    },
    {
      "t0": 52.02,
      "t1": 54.98,
      "texto": "\"Ele foi hospedar-se na casa de um pecador!\""
    },
    {
      "t0": 56.1,
      "t1": 58.7,
      "texto": "Zaqueu ficou de pé, e disse ao Senhor:"
    },
    {
      "t0": 58.7,
      "t1": 62.68,
      "texto": "\"Senhor, eu dou a metade dos meus bens aos pobres,"
    },
    {
      "t0": 62.74,
      "t1": 64.22,
      "texto": "e se defraudei"
    },
    {
      "t0": 64.22,
      "t1": 66.94,
      "texto": "alguém, vou devolver quatro vezes mais\"."
    },
    {
      "t0": 67.74,
      "t1": 68.96,
      "texto": "Jesus lhe disse:"
    },
    {
      "t0": 69.66,
      "t1": 72.2,
      "texto": "\"Hoje a salvação entrou nesta casa,"
    },
    {
      "t0": 72.56,
      "t1": 75.64,
      "texto": "porque também este homem é um filho de Abraão."
    },
    {
      "t0": 76.31,
      "t1": 78.58,
      "texto": "Com efeito, o Filho do Homem"
    },
    {
      "t0": 78.58,
      "t1": 81.8,
      "texto": "veio procurar e salvar o que estava perdido\"."
    },
    {
      "t0": 82.86,
      "t1": 84.26,
      "texto": "Palavra da Salvação."
    }
  ]
}
