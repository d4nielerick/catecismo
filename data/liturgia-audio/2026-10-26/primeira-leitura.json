{
  "referencia": "Ef 4,32-5,8",
  "voz": "Algenib (gemini-3.8-flash-tts)",
  "duracao": 76.02,
  "linhas": [
    {
      "t0": 0,
      "t1": 2.6,
      "texto": "Leitura da Carta de São Paulo aos Efésios."
    },
    {
      "t0": 3.38,
      "t1": 3.98,
      "texto": "Irmãos,"
    },
    {
      "t0": 4.54,
      "t1": 6.24,
      "texto": "sede bons uns para com os outros,"
    },
    {
      "t0": 6.6,
      "t1": 7.66,
      "texto": "sede compassivos;"
    },
    {
      "t0": 7.66,
      "t1": 9.76,
      "texto": "perdoai-vos mutuamente,"
    },
    {
      "t0": 10.04,
      "t1": 12.9,
      "texto": "como Deus vos perdoou por meio de Cristo."
    },
    {
      "t0": 13.84,
      "t1": 15.5,
      "texto": "Sede imitadores de Deus,"
    },
    {
      "t0": 15.72,
      "t1": 17.18,
      "texto": "como filhos que ele ama."
    },
    {
      "t0": 18.12,
      "t1": 20.66,
      "texto": "Vivei no amor, como Cristo nos amou"
    },
    {
      "t0": 20.9,
      "t1": 23.54,
      "texto": "e se entregou a si mesmo a Deus por nós,"
    },
    {
      "t0": 23.82,
      "t1": 26.58,
      "texto": "em oblação e sacrifício de suave odor."
    },
    {
      "t0": 26.58,
      "t1": 28.76,
      "texto": "A devassidão,"
    },
    {
      "t0": 28.76,
      "t1": 31.56,
      "texto": "ou qualquer espécie de impureza ou cobiça"
    },
    {
      "t0": 31.76,
      "t1": 34.1,
      "texto": "sequer sejam mencionadas entre vós,"
    },
    {
      "t0": 34.32,
      "t1": 35.72,
      "texto": "como convém a santos."
    },
    {
      "t0": 36.32,
      "t1": 38.24,
      "texto": "Nada de palavras grosseiras,"
    },
    {
      "t0": 38.5,
      "t1": 40.06,
      "texto": "insensatas ou obscenas,"
    },
    {
      "t0": 40.3,
      "t1": 41.8,
      "texto": "que são inconvenientes;"
    },
    {
      "t0": 41.8,
      "t1": 45.18,
      "texto": "dedicai-vos antes à ação de graças."
    },
    {
      "t0": 45.98,
      "t1": 49.96,
      "texto": "Pois, sabei-o bem, o devasso, o impuro,"
    },
    {
      "t0": 50.2,
      "t1": 52.86,
      "texto": "o avarento - que é um idólatra -"
    },
    {
      "t0": 52.86,
      "t1": 54.4,
      "texto": "são excluídos da herança"
    },
    {
      "t0": 54.4,
      "t1": 56.08,
      "texto": "no reino de Cristo e de Deus."
    },
    {
      "t0": 56.58,
      "t1": 59.62,
      "texto": "Que ninguém vos engane com palavras vazias."
    },
    {
      "t0": 60.08,
      "t1": 62.54,
      "texto": "Tudo isso atrai a cólera de Deus"
    },
    {
      "t0": 62.54,
      "t1": 64.16,
      "texto": "sobre os que lhe desobedecem."
    },
    {
      "t0": 65,
      "t1": 66.52,
      "texto": "Não sejais seus cúmplices."
    },
    {
      "t0": 67.74,
      "t1": 69.18,
      "texto": "Outrora éreis trevas,"
    },
    {
      "t0": 69.48,
      "t1": 71.42,
      "texto": "mas agora sois luz no Senhor."
    },
    {
      "t0": 72.18,
      "t1": 74.06,
      "texto": "Vivei como filhos da luz."
    },
    {
      "t0": 74.92,
      "t1": 76.02,
      "texto": "Palavra do Senhor."
    }
  ]
}
