{
  "referencia": "Lc 17,11-19",
  "voz": "Algenib (gemini-3.8-flash-tts)",
  "duracao": 63.4,
  "linhas": [
    {
      "t0": 0,
      "t1": 3.72,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 3.72,
      "t1": 6.74,
      "texto": "Aconteceu que, caminhando para Jerusalém,"
    },
    {
      "t0": 7.3,
      "t1": 10.04,
      "texto": "Jesus passava entre a Samaria e a Galileia."
    },
    {
      "t0": 10.32,
      "t1": 12.54,
      "texto": "Quando estava para entrar num povoado,"
    },
    {
      "t0": 13.02,
      "t1": 15,
      "texto": "dez leprosos vieram ao seu encontro."
    },
    {
      "t0": 15.28,
      "t1": 16.58,
      "texto": "Pararam à distância,"
    },
    {
      "t0": 16.58,
      "t1": 18,
      "texto": "e gritaram:"
    },
    {
      "t0": 18.75,
      "t1": 22.22,
      "texto": "\"Jesus, Mestre, tem compaixão de nós!\""
    },
    {
      "t0": 22.66,
      "t1": 24.76,
      "texto": "Ao vê-los, Jesus disse:"
    },
    {
      "t0": 25.54,
      "t1": 27.38,
      "texto": "\"Ide apresentar-vos aos sacerdotes\"."
    },
    {
      "t0": 28.22,
      "t1": 29.2,
      "texto": "Enquanto caminhavam,"
    },
    {
      "t0": 29.48,
      "t1": 31.32,
      "texto": "aconteceu que ficaram curados."
    },
    {
      "t0": 31.86,
      "t1": 34.56,
      "texto": "Um deles, ao perceber que estava curado,"
    },
    {
      "t0": 35.2,
      "t1": 37.34,
      "texto": "voltou glorificando a Deus em alta voz;"
    },
    {
      "t0": 37.34,
      "t1": 39.5,
      "texto": "atirou-se aos pés de Jesus,"
    },
    {
      "t0": 39.76,
      "t1": 41.22,
      "texto": "com o rosto por terra,"
    },
    {
      "t0": 41.42,
      "t1": 42.44,
      "texto": "e lhe agradeceu."
    },
    {
      "t0": 42.8,
      "t1": 44.52,
      "texto": "E este era um samaritano."
    },
    {
      "t0": 45,
      "t1": 46.8,
      "texto": "Então Jesus lhe perguntou:"
    },
    {
      "t0": 47.1,
      "t1": 48.76,
      "texto": "\"Não foram dez os curados?"
    },
    {
      "t0": 49.1,
      "t1": 51.18,
      "texto": "E os outro nove, onde estão?"
    },
    {
      "t0": 51.54,
      "t1": 54.34,
      "texto": "Não houve quem voltasse para dar glória a Deus,"
    },
    {
      "t0": 54.58,
      "t1": 56.28,
      "texto": "a não ser este estrangeiro?\""
    },
    {
      "t0": 56.28,
      "t1": 58.98,
      "texto": "E disse-lhe:"
    },
    {
      "t0": 58.98,
      "t1": 61.68,
      "texto": "\"Levanta-te e vai! Tua fé te salvou\"."
    },
    {
      "t0": 62.08,
      "t1": 63.4,
      "texto": "Palavra da Salvação."
    }
  ]
}
