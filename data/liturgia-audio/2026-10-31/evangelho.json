  "linhas": [
    {
      "t0": 0,
      "t1": 3.8,
      "texto": "Evangelho de Nosso Senhor Jesus Cristo segundo Lucas."
    },
    {
      "t0": 4.08,
      "t1": 6.8,
      "texto": "Aconteceu que, num dia de sábado,"
    },
    {
      "t0": 6.88,
      "t1": 8.32,
      "texto": "Jesus foi comer na casa"
    },
    {
      "t0": 8.4,
      "t1": 10.24,
      "texto": "de um dos chefes dos fariseus."
    },
    {
      "t0": 10.8,
      "t1": 12.52,
      "texto": "E eles o observavam."
    },
    {
      "t0": 12.8,
      "t1": 14.56,
      "texto": "Jesus notou como os convidados"
    },
    {
      "t0": 14.64,
      "t1": 16.76,
      "texto": "escolhiam os primeiros lugares."
    },
    {
      "t0": 17.04,
      "t1": 19.44,
      "texto": "Então contou-lhes uma parábola:"
    },
    {
      "t0": 19.68,
      "t1": 20.96,
      "texto": "\"Quando tu fores convidado"
    },
    {
      "t0": 21.04,
      "t1": 22.8,
      "texto": "para uma festa de casamento,"
    },
    {
      "t0": 22.96,
      "t1": 24.72,
      "texto": "não ocupes o primeiro lugar."
    },
    {
      "t0": 25.28,
      "t1": 26.88,
      "texto": "Pode ser que tenha sido convidado"
    },
    {
      "t0": 26.96,
      "t1": 29.2,
      "texto": "alguém mais importante do que tu,"
    },
    {
      "t0": 29.24,
      "t1": 31.76,
      "texto": "e o dono da casa, que convidou os dois,"
    },
    {
      "t0": 31.84,
      "t1": 32.64,
      "texto": "venha te dizer:"
    },
    {
      "t0": 33.12,
      "t1": 34.08,
      "texto": "'Dá o lugar a ele'."
    },
    {
      "t0": 34.56,
      "t1": 36.64,
      "texto": "Então tu ficarás envergonhado"
    },
    {
      "t0": 36.96,
      "t1": 39.08,
      "texto": "e irás ocupar o último lugar."
    },
    {
      "t0": 39.36,
      "t1": 41.68,
      "texto": "Mas, quando tu fores convidado,"
    },
    {
      "t0": 41.76,
      "t1": 43.84,
      "texto": "vai sentar-te no último lugar."
    },
    {
      "t0": 44.08,
      "t1": 47.2,
      "texto": "Assim, quando chegar quem te convidou, te dirá:"
    },
    {
      "t0": 47.44,
      "t1": 49.2,
      "texto": "'Amigo, vem mais para cima'."
    },
    {
      "t0": 49.68,
      "t1": 51.52,
      "texto": "E isto vai ser uma honra para ti"
    },
    {
      "t0": 51.6,
      "t1": 53.76,
      "texto": "diante de todos os convidados."
    },
    {
      "t0": 54,
      "t1": 56.24,
      "texto": "Porque quem se eleva, será humilhado"
    },
    {
      "t0": 56.64,
      "t1": 59.36,
      "texto": "e quem se humilha, será elevado\"."
    },
    {
      "t0": 59.44,
      "t1": 61.2,
      "texto": "Palavra da Salvação."
    }
  ]
}
